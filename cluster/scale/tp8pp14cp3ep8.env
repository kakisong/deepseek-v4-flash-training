#!/usr/bin/env bash
# Scale: TP=8 PP=14 CP=3 EP=8 ETP=1 = 336 GPUs (42 nodes), PP*CP=42.
# High PP halves per-stage weight memory (3 layers/stage vs PP7's 6) -> headroom to
# REDUCE recompute (cut the ~44% HBM-bandwidth cost), at the price of more PP bubble
# ((14-1)/128 = 10% vs PP7's 4.7%). The one config direction that can beat PP7CP6 IF
# the recompute-HBM savings exceed the extra bubble. 43 layers over 14 stages: 3/3.../4.
export PRESET_TP=8
export PRESET_PP=14
export PRESET_CP=3
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_PIPELINE_LAYOUT='Et*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*4L'

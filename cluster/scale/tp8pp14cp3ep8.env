#!/usr/bin/env bash
# Scale: TP=8 PP=14 CP=3 EP=8 ETP=1 = 336 GPU (42 节点), PP*CP=42。
# 高 PP 让每个 stage 的权重显存减半 (3 层/stage,PP7 是 6 层) -> 留出余量去
# 减少 recompute (省掉 ~44% 的 HBM 带宽开销),代价是更大的 PP bubble
# ((14-1)/128 = 10%,PP7 是 4.7%)。这是唯一有机会胜过 PP7CP6 的配置方向——前提是
# recompute 省下的 HBM 开销要超过多出来的 bubble。43 层分到 14 个 stage: 3/3.../4。
export PRESET_TP=8
export PRESET_PP=14
export PRESET_CP=3
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_PIPELINE_LAYOUT='Et*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*4L'

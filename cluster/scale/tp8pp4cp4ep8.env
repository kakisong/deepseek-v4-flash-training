#!/usr/bin/env bash
# Scale: TP=8 PP=4 CP=4 EP=8 ETP=1 = 128 actor GPUs (16 nodes).
# Replicates the H20 lr0mjb4o config (TP8 PP4 CP4, 16 nodes) that reached ~34% MFU /
# ~50 TFLOPS on albaliang 128K, to test whether matching H20's parallelism (fewer nodes,
# more work/GPU, less CP comm) raises H200 MFU vs the 42-node PP7/CP6 baseline.
# 43 layers over 4 stages, matched to H20 stageAlb128K exactly:
# decoder-first 11, decoder-last 10 -> 11/11/11/10.
export PRESET_TP=8
export PRESET_PP=4
export PRESET_CP=4
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_PIPELINE_LAYOUT='Et*11|t*11|t*11|t*10L'

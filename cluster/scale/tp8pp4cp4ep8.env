#!/usr/bin/env bash
# Scale: TP=8 PP=4 CP=4 EP=8 ETP=1 = 128 GPU/replica.
# 16-node H20 128K DP=1 shape. CP=4 requires
# HW_MAX_TOKENS_PER_GPU=32768 for 128K context while keeping PP=4's lower
# pipeline depth versus PP8.
#
# 2026-06-02 Albaliang 128K smoke passed:
#   actor_train_time=748.6s, step_time=783.6s, peak observed GRAM ~=85.5GB.

export PRESET_TP=8
export PRESET_PP=4
export PRESET_CP=4
export PRESET_EP=8
export PRESET_ETP=1

export PRESET_DECODER_FIRST_PIPELINE_NUM_LAYERS=11
export PRESET_DECODER_LAST_PIPELINE_NUM_LAYERS=10

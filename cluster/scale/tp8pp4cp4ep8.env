#!/usr/bin/env bash
# Scale: TP=8 PP=4 CP=4 EP=8 ETP=1 = 128 个 actor GPU (16 节点)。
# 复刻 H20 lr0mjb4o 配置 (TP8 PP4 CP4,16 节点)——它在 albaliang 128K 上跑到过 ~34% MFU /
# ~50 TFLOPS——用来检验对齐 H20 的并行方式 (节点更少、
# 每 GPU 工作量更大、CP 通信更少) 能否让 H200 的 MFU 超过 42 节点 PP7/CP6 基线。
# 43 层分到 4 个 stage,与 H20 stageAlb128K 完全对齐:
# decoder-first 11,decoder-last 10 -> 11/11/11/10。
export PRESET_TP=8
export PRESET_PP=4
export PRESET_CP=4
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_PIPELINE_LAYOUT='Et*11|t*11|t*11|t*10L'

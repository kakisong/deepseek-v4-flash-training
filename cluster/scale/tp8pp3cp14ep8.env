#!/usr/bin/env bash
# Scale: TP=8 PP=3 CP=14 EP=8 ETP=1 = 336 actor GPUs.
# Post-EFA aggressive probe: CP=14 -> per-rank seq ~9.6K -> low activation memory,
# target no/selective recompute. PP3 bubble only 1.6%. CP14 ring-attention is heavy
# but cheap on EFA. 43 decoder layers over 3 stages as 14/14/15.
export PRESET_TP=8
export PRESET_PP=3
export PRESET_CP=14
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_PIPELINE_LAYOUT='Et*14|t*14|t*15L'

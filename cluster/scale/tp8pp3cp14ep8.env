#!/usr/bin/env bash
# Scale: TP=8 PP=3 CP=14 EP=8 ETP=1 = 336 个 actor GPU。
# EFA 上线后的激进探测: CP=14 -> 每 rank seq ~9.6K -> activation 显存低,
# 目标是不做或只做选择性 recompute。PP3 bubble 只有 1.6%。CP14 的 ring-attention 很重,
# 但在 EFA 上开销不大。43 层 decoder 按 14/14/15 分到 3 个 stage。
export PRESET_TP=8
export PRESET_PP=3
export PRESET_CP=14
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_PIPELINE_LAYOUT='Et*14|t*14|t*15L'

#!/usr/bin/env bash
# Scale: TP=8 PP=7 CP=6 EP=8 ETP=1 = 336 actor GPUs.
#
# Current default scale for the 42-node H200 kaynzhang_077 134K SFT run.
# TP=8 stays
# intra-node, PP=7 x CP=6 consumes exactly 42 eight-GPU nodes, and CP=6 keeps
# 134129-token samples at <= 22355 tokens per CP rank.
#
# PP=7 layout: 43 decoder layers over 7 stages as 6/6/6/6/6/6/7.
# Pair with workload/sft_kaynzhang_077_134k_3epoch.env for the P3-derived
# current default.
export PRESET_TP=8
export PRESET_PP=7
export PRESET_CP=6
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_PIPELINE_LAYOUT='Et*6|t*6|t*6|t*6|t*6|t*6|t*7L'

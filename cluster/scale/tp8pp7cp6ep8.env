#!/usr/bin/env bash
# Scale: TP=8 PP=7 CP=6 EP=8 ETP=1 = 336 个 actor GPU。
#
# 42 节点 H200 kaynzhang_077 134K SFT 运行当前的默认 scale。
# TP=8 保持
# 节点内,PP=7 x CP=6 恰好占满 42 台 8 GPU 节点,CP=6 让
# 134129 token 的样本在每个 CP rank 上 <= 22355 token。
#
# PP=7 layout: 43 层 decoder 按 6/6/6/6/6/6/7 分到 7 个 stage。
# 与 workload/sft_kaynzhang_077_134k_3epoch.env 搭配使用,即源自 P3 的
# 当前默认配置。
export PRESET_TP=8
export PRESET_PP=7
export PRESET_CP=6
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_PIPELINE_LAYOUT='Et*6|t*6|t*6|t*6|t*6|t*6|t*7L'

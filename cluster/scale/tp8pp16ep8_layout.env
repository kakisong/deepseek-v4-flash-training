#!/usr/bin/env bash
# Scale: 16 节点 PP=16 (128 GPU = TP=8 × PP=16 × EP=8 → DP=1)。
# 复用 prod 现有 16-stage layout, PP=16 时 stages_in_layout/PP = 1 → VPP 自动 disable。
# 每 rank 只持 1 stage,activation peak 约减半,Adam state 40→20 GB/rank 可关 cpu-offload。

export PRESET_TP=8
export PRESET_PP=16
export PRESET_CP=1
export PRESET_EP=8
export PRESET_ETP=1

export PRESET_PIPELINE_LAYOUT='Ett|(ttt|)*11,(tt|)*3,ttL'

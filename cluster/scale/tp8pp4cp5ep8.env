#!/usr/bin/env bash
# Scale: TP=8 PP=4 CP=5 EP=8 ETP=1 = 160 GPU/replica。在 40 节点 fleet (320 GPU) 上
# 会自动得到 DP=2 (320 / (8*4*5) = 2) -> 即 “PP4 CP5 DP2”。
#
# 与 tp8pp8cp5ep8 (PP8 CP5 DP1) 的受控 A/B: 每 rank seq 相同 (51.2K,高于 ~32K
# 拐点),同样是 40 节点,唯一差异是 PP8-DP1 vs PP4-DP2。检验轻 PP+DP1 能否
# 胜过重 PP+DP2——预测是能: PP4CP5DP2 约 18.9% (在 ~20% 的饱和基线上扣掉实测 ~1.1pp 的 DP2
# 损耗),显存紧绷在 ~89% (PP4 每 stage 11 层的权重);而 PP8CP5 约 20%,显存安全在
# 65%。用实测终结“为什么不直接用 PP4+DP2 填满 40 节点”这个疑问。
# 43 层 decoder 按 11/11/11/10 分到 4 个 stage (与 tp8pp4cp8/cp10 相同)。
# 要求 seq 能被 2*CP=10 整除 -> 使用 --seq-length 262400 --max-tokens-per-gpu 52480。
export PRESET_TP=8
export PRESET_PP=4
export PRESET_CP=5
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_DECODER_FIRST_PIPELINE_NUM_LAYERS=11
export PRESET_DECODER_LAST_PIPELINE_NUM_LAYERS=10

#!/usr/bin/env bash
# Scale: TP=8 PP=4 CP=5 EP=8 ETP=1 = 160 GPU/replica. On the 40-node fleet (320 GPU) this
# yields DP=2 automatically (320 / (8*4*5) = 2) -> "PP4 CP5 DP2".
#
# The controlled A/B vs tp8pp8cp5ep8 (PP8 CP5 DP1): SAME per-rank seq (51.2K, above the ~32K
# knee) and SAME 40 nodes, differing ONLY in PP8-DP1 vs PP4-DP2. Tests whether light-PP+DP1
# beats heavy-PP+DP2 — predicted yes: PP4CP5DP2 ~18.9% (the measured ~1.1pp DP2 penalty off the
# ~20% saturated base) at ragged ~89% memory (PP4's 11-layer/stage weights), vs PP8CP5 ~20% at
# safe 65%. Closes the "why not just fill 40 nodes with PP4+DP2" question empirically.
# 43 decoder layers over 4 stages as 11/11/11/10 (same as tp8pp4cp8/cp10).
# Requires seq divisible by 2*CP=10 -> use --seq-length 262400 --max-tokens-per-gpu 52480.
export PRESET_TP=8
export PRESET_PP=4
export PRESET_CP=5
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_DECODER_FIRST_PIPELINE_NUM_LAYERS=11
export PRESET_DECODER_LAST_PIPELINE_NUM_LAYERS=10

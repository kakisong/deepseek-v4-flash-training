#!/usr/bin/env bash
# Scale: TP=8 PP=3 CP=7 EP=8 ETP=1 = 168 GPU/replica。
#
# 探索性的 bubble-vs-comm 探测 (未验证)。介于现有的
# tp8pp3cp4 和 tp8pp3cp14 之间:
#   - PP=3 把 pipeline bubble 压到极低 (~37 个 microbatch 时 PP7 ~16% -> PP3 ~5%)。
#   - CP=7 (相对 cp14) 把 ring-attention 参与者减半 => CP 通信约减半,
#     但每 rank seq 约为 cp14 的 2 倍 (134K/7 ~= 19K vs 9.6K) => activation 约 2 倍。
# 这次探测要回答的开放问题: 在 PP3 更重的每 stage 权重 (14-15 层) 下,
# 更高的 CP7 activation 在 full/uniform/1 recompute 下还放得下吗?
# 如果放得下,PP3/CP7 的吞吐会胜过 PP3/CP14 (通信更轻,bubble 收益相同)。
# 如果 OOM,就回退到已验证的 tp8pp3cp14ep8。
#
# GPU 计算: 168 = DP1 下 21 个节点。在 42 节点 fleet 上 launcher 会推导出 DP=2
# (336/168),这会稀释 PP3 的 bubble (~5% -> ~8%),并额外增加一次 DP all-reduce。
# 43 层 decoder 按 14/14/15 分到 3 个 stage (layout 与 tp8pp3cp14ep8 相同)。
export PRESET_TP=8
export PRESET_PP=3
export PRESET_CP=7
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_PIPELINE_LAYOUT='Et*14|t*14|t*15L'

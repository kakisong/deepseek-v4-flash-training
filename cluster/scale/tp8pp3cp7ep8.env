#!/usr/bin/env bash
# Scale: TP=8 PP=3 CP=7 EP=8 ETP=1 = 168 GPU/replica.
#
# Exploratory bubble-vs-comm probe (UNVALIDATED). Sits between the existing
# tp8pp3cp4 and tp8pp3cp14:
#   - PP=3 collapses the pipeline bubble (PP7 ~16% at ~37 microbatches -> PP3 ~5%).
#   - CP=7 (vs cp14) halves the ring-attention participants => ~half the CP comm,
#     but leaves per-rank seq ~2x cp14's (134K/7 ~= 19K vs 9.6K) => ~2x activation.
# The open question this probe answers: does the higher CP7 activation still fit
# under full/uniform/1 recompute given PP3's heavier per-stage weights (14-15 layers)?
# If it fits, PP3/CP7 beats PP3/CP14 on throughput (lighter comm, same bubble win).
# If it OOMs, fall back to the proven tp8pp3cp14ep8.
#
# GPU math: 168 = 21 nodes at DP1. On the 42-node fleet the launcher derives DP=2
# (336/168), which dilutes PP3's bubble (~5% -> ~8%) + adds a DP all-reduce.
# 43 decoder layers over 3 stages as 14/14/15 (same layout as tp8pp3cp14ep8).
export PRESET_TP=8
export PRESET_PP=3
export PRESET_CP=7
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_PIPELINE_LAYOUT='Et*14|t*14|t*15L'

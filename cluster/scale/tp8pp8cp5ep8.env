#!/usr/bin/env bash
# Scale: TP=8 PP=8 CP=5 EP=8 ETP=1 = 320 GPU/replica = 40 节点 (DP1)。
#
# 有希望的生产候选。PP8 的轻权重 (初始化后 ~33GB) 让显存保持
# 安全,同时 CP=5 给出每 rank seq 51.2K——高于 ~32K 的 MFU 饱和拐点 (文档 §11),
# 因此应能稳住 ~20% MFU,而且是在 40 节点 DP1 上 (没有 DP-allreduce/bubble 损耗)。
# 目标: 追平 CP7-DP2 在 42 节点的 wall-clock,同时避开其 DP2 损耗和紧绷的 99.5% 显存。
# 43 层 decoder 按 5/5/5/5/5/6/6/6 分到 8 个 stage (与 tp8pp8cp4ep8 相同)。
# 要求 seq 能被 2*CP=10 整除 -> 使用 --seq-length 262400 --max-tokens-per-gpu 52480。
export PRESET_TP=8
export PRESET_PP=8
export PRESET_CP=5
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_PIPELINE_LAYOUT='Et*5|t*5|t*5|t*5|t*5|t*6|t*6|t*6L'

#!/usr/bin/env bash
# Scale: TP=8 PP=8 CP=5 EP=8 ETP=1 = 320 GPU/replica = 40 nodes (DP1).
#
# The promising production candidate. PP8's light weights (~33GB after init) keep memory
# safe while CP=5 gives per-rank seq 51.2K — ABOVE the ~32K MFU-saturation knee (doc §11),
# so it should hold ~20% MFU, but on 40 nodes at DP1 (no DP-allreduce/bubble penalty).
# Goal: match CP7-DP2's 42-node wall-clock WITHOUT its DP2 penalty or ragged 99.5% memory.
# 43 decoder layers over 8 stages as 5/5/5/5/5/6/6/6 (same as tp8pp8cp4ep8).
# Requires seq divisible by 2*CP=10 -> use --seq-length 262400 --max-tokens-per-gpu 52480.
export PRESET_TP=8
export PRESET_PP=8
export PRESET_CP=5
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_PIPELINE_LAYOUT='Et*5|t*5|t*5|t*5|t*5|t*6|t*6|t*6L'

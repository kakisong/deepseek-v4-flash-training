#!/usr/bin/env bash
# Scale: TP=8 PP=4 CP=1 EP=8 ETP=1 = 32 GPU/replica.
# On 16-node H20 this gives DP=4 for 128K probes. Use
# --max-tokens-per-gpu 131072 for full 128K local context.

export PRESET_TP=8
export PRESET_PP=4
export PRESET_CP=1
export PRESET_EP=8
export PRESET_ETP=1

export PRESET_DECODER_FIRST_PIPELINE_NUM_LAYERS=11
export PRESET_DECODER_LAST_PIPELINE_NUM_LAYERS=10

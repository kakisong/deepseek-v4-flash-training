#!/usr/bin/env bash
# Scale: TP=8 PP=4 CP=1 EP=8 ETP=1 = 32 GPU/replica。
# 在 16 节点 H20 上可得到 DP=4,用于 128K 探测。要获得完整的 128K 本地 context,
# 请使用 --max-tokens-per-gpu 131072。

export PRESET_TP=8
export PRESET_PP=4
export PRESET_CP=1
export PRESET_EP=8
export PRESET_ETP=1

export PRESET_DECODER_FIRST_PIPELINE_NUM_LAYERS=11
export PRESET_DECODER_LAST_PIPELINE_NUM_LAYERS=10

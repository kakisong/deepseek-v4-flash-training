#!/usr/bin/env bash
# Scale: TP=4 × PP=16 × CP=2 × EP=8 ETP=1 = 128 GPU/replica。
# 16 节点 H20 上的 32K context: PP=16 让 Adam state 切到极小,CP=2 把 32K seq 切成 16K/CP-rank,
# TP=4 跟 8 节点 albaliang shape 保持一致。
#
# 复用 prod 16-stage layout: 'Ett|(ttt|)*11,(tt|)*3,ttL'。PP=16 时 stages_in_layout/PP=1, VPP=1。
#
# 实测 (WRITEUP §4.18.6, 2026-05-22): step median 58.4s vs 8 节点 119s = -50.9%, peak ~30 GB / 95 GB。

export PRESET_TP=4
export PRESET_PP=16
export PRESET_CP=2
export PRESET_EP=8
export PRESET_ETP=1

export PRESET_PIPELINE_LAYOUT='Ett|(ttt|)*11,(tt|)*3,ttL'

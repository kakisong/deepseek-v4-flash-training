#!/usr/bin/env bash
# Scale: TP=8 PP=3 CP=4 EP=8 ETP=1 = 96 GPU/replica.
# Experimental 12-node H20 128K shape. The 2026-06-01 smoke failed during
# model init with CUDA OOM from the large PP=3 grad buffer. Use tp8pp6cp2ep8
# for the current performance-oriented 128K run, or tp4pp6cp4ep8 as the
# conservative fallback.
#
# Original motivation:
#   - TP=8 is intended to stay intra-node on 8-GPU H20 hosts.
#   - CP=4 gives 32768 local tokens/rank at 128K.
#   - PP=3 maps to three 4-node pipeline stages and reduces pipeline bubble
#     versus the earlier PP=6 256K probe shape.

export PRESET_TP=8
export PRESET_PP=3
export PRESET_CP=4
export PRESET_EP=8
export PRESET_ETP=1

# 43 decoder layers over 3 physical pipeline stages: 14/14/15.
export PRESET_PIPELINE_LAYOUT='Et*14|t*14|t*15L'

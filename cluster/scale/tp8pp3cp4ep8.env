#!/usr/bin/env bash
# Scale: TP=8 PP=3 CP=4 EP=8 ETP=1 = 96 GPU/replica。
# 实验性的 12 节点 H20 128K shape。2026-06-01 的 smoke 在模型初始化阶段
# 因 PP=3 的大 grad buffer 触发 CUDA OOM 而失败。当前面向性能的 128K 运行
# 请使用 tp8pp6cp2ep8,保守回退方案
# 则使用 tp4pp6cp4ep8。
#
# 最初的动机:
#   - TP=8 的意图是在 8 GPU 的 H20 机器上保持节点内通信。
#   - CP=4 在 128K 下让每 rank 本地 token 数为 32768。
#   - PP=3 映射为三个 4 节点的 pipeline stage,相比更早的 PP=6 256K 探测 shape
#     减小了 pipeline bubble。

export PRESET_TP=8
export PRESET_PP=3
export PRESET_CP=4
export PRESET_EP=8
export PRESET_ETP=1

# 43 层 decoder 分布到 3 个物理 pipeline stage: 14/14/15。
export PRESET_PIPELINE_LAYOUT='Et*14|t*14|t*15L'

#!/usr/bin/env bash
# Scale: TP=2 PP=4 CP=8 EP=8 ETP=1 = 64 GPU/replica。
# Albaliang 64K smoke (TP 缩到 2 让 CP 涨到 8 撑 64K)。

export PRESET_TP=2
export PRESET_PP=4
export PRESET_CP=8
export PRESET_EP=8
export PRESET_ETP=1

export PRESET_DECODER_FIRST_PIPELINE_NUM_LAYERS=11
export PRESET_DECODER_LAST_PIPELINE_NUM_LAYERS=10

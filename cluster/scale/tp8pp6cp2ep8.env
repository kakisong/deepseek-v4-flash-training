#!/usr/bin/env bash
# Scale: TP=8 PP=6 CP=2 EP=8 ETP=1 = 96 GPU/replica.
# 12-node H20 128K shape. PP=6 avoids the large PP=3 grad buffer, while TP=8
# stays intra-node. CP=2 requires HW_MAX_TOKENS_PER_GPU=65536 for 128K context,
# so this shape shifts risk to activation/attention memory.
#
# 2026-06-01 smoke passed with:
#   --workload sft_albaliang_128k_3epoch --num-rollout 1 --max-tokens-per-gpu 65536
#   actor_train_time=1132.0s, step_time=1169.3s, peak observed used ~= 78GB.

export PRESET_TP=8
export PRESET_PP=6
export PRESET_CP=2
export PRESET_EP=8
export PRESET_ETP=1

# 43 decoder layers over 6 physical pipeline stages: 7/7/7/7/7/8.
export PRESET_PIPELINE_LAYOUT='Et*7|t*7|t*7|t*7|t*7|t*8L'

#!/usr/bin/env bash
# Scale: TP=8 PP=6 CP=2 EP=8 ETP=1 = 96 GPU/replica。
# 12 节点 H20 128K shape。PP=6 避开了 PP=3 的大 grad buffer,同时 TP=8
# 保持在节点内。128K context 下 CP=2 需要 HW_MAX_TOKENS_PER_GPU=65536,
# 因此这个 shape 把风险转移到 activation/attention 显存上。
#
# 2026-06-01 smoke 已通过,所用参数:
#   --workload sft_albaliang_128k_3epoch --num-rollout 1 --max-tokens-per-gpu 65536
#   actor_train_time=1132.0s, step_time=1169.3s, 观测峰值占用 ~= 78GB。

export PRESET_TP=8
export PRESET_PP=6
export PRESET_CP=2
export PRESET_EP=8
export PRESET_ETP=1

# 43 层 decoder 分布到 6 个物理 pipeline stage: 7/7/7/7/7/8。
export PRESET_PIPELINE_LAYOUT='Et*7|t*7|t*7|t*7|t*7|t*8L'

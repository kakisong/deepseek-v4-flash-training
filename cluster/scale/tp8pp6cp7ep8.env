#!/usr/bin/env bash
# Scale: TP=8 PP=6 CP=7 EP=8 ETP=1 = 336 个 actor GPU。
# EFA 上线后的探测: 更高的 CP (7 vs 6) 把每 rank seq 降到 ~19.2K -> activation
# 显存更少 -> 可以用更轻的 recompute;PP6 bubble 3.9% (< PP7 的 4.7%)。
# 43 层 decoder 按 7/7/7/7/7/8 分到 6 个 stage。
export PRESET_TP=8
export PRESET_PP=6
export PRESET_CP=7
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_PIPELINE_LAYOUT='Et*7|t*7|t*7|t*7|t*7|t*8L'

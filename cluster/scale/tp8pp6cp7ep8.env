#!/usr/bin/env bash
# Scale: TP=8 PP=6 CP=7 EP=8 ETP=1 = 336 actor GPUs.
# Post-EFA probe: higher CP (7 vs 6) cuts per-rank seq to ~19.2K -> less activation
# memory -> enables lighter recompute; PP6 bubble 3.9% (< PP7's 4.7%).
# 43 decoder layers over 6 stages as 7/7/7/7/7/8.
export PRESET_TP=8
export PRESET_PP=6
export PRESET_CP=7
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_PIPELINE_LAYOUT='Et*7|t*7|t*7|t*7|t*7|t*8L'

#!/usr/bin/env bash
# Scale: TP=8 PP=8 CP=4 EP=8 ETP=1 = 256 GPU/replica = 32 节点 (DP1)。
#
# “轻 PP 解锁长 CP”探测: PP8 => 每 stage 只有 ~5-6 层 => 每 GPU 权重很轻
# (约为 PP3 的一半),从而缓解了迫使 PP3 用高 CP 的显存墙。这份余量
# 让 CP=4 放得下 (每 rank seq 64K——最长、基础 MFU 最高、但在 PP3 CP4 下曾 OOM 的点)。
# 取舍: PP8 bubble ~15% (偏高) vs 64K/rank 的高基础 MFU。用来测量 MFU 随每 rank seq
# 变化曲线的顶部 (越过 CP6 的 43.7K 之后还会继续上升,还是已经饱和?)。
# 43 层 decoder 按 5/5/5/5/5/6/6/6 分到 8 个 stage。
export PRESET_TP=8
export PRESET_PP=8
export PRESET_CP=4
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_PIPELINE_LAYOUT='Et*5|t*5|t*5|t*5|t*5|t*6|t*6|t*6L'

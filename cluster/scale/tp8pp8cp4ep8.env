#!/usr/bin/env bash
# Scale: TP=8 PP=8 CP=4 EP=8 ETP=1 = 256 GPU/replica = 32 nodes (DP1).
#
# "Light-PP unlocks long-CP" probe: PP8 => only ~5-6 layers/stage => light per-GPU weights
# (~half of PP3's), which RELIEVES the memory wall that forced PP3 to high CP. That headroom
# lets CP=4 fit (per-rank seq 64K — the longest, highest-MFU point that OOM'd under PP3 CP4).
# Trades: PP8 bubble ~15% (high) vs 64K/rank's high base MFU. Measures the top of the
# MFU-vs-per-rank-seq curve (does it still climb past CP6's 43.7K, or saturate?).
# 43 decoder layers over 8 stages as 5/5/5/5/5/6/6/6.
export PRESET_TP=8
export PRESET_PP=8
export PRESET_CP=4
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_PIPELINE_LAYOUT='Et*5|t*5|t*5|t*5|t*5|t*6|t*6|t*6L'

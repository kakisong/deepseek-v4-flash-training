#!/usr/bin/env bash
# Scale: TP=8 PP=7 CP=6 EP=8 ETP=1 = 336 actor GPUs, with layout-derived VPP=2.
#
# The 14 layout stages map to PP=7 as two virtual chunks per physical rank.
# Per physical rank decoder-layer totals stay aligned with the P3 baseline:
# 6/6/6/6/6/6/7 layers, but split into 3-layer virtual chunks plus a final 4.

export PRESET_TP=8
export PRESET_PP=7
export PRESET_CP=6
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_VPP=2
export PRESET_PIPELINE_LAYOUT='Et*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*4L'

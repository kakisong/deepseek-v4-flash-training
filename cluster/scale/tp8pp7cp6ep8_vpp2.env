#!/usr/bin/env bash
# Scale: TP=8 PP=7 CP=6 EP=8 ETP=1 = 336 个 actor GPU,VPP=2 由 layout 推导。
#
# 14 个 layout stage 映射到 PP=7,每个物理 rank 两个 virtual chunk。
# 每个物理 rank 的 decoder 层数总和与 P3 基线保持对齐:
# 6/6/6/6/6/6/7 层,只是拆成每个 3 层的 virtual chunk,最后一个为 4 层。

export PRESET_TP=8
export PRESET_PP=7
export PRESET_CP=6
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_VPP=2
export PRESET_PIPELINE_LAYOUT='Et*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*3|t*4L'

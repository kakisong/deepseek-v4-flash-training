#!/usr/bin/env bash
# Scale: TP=8 PP=8 CP=1 EP=8 ETP=1 + layout 'Ett|(ttt|)*11,(tt|)*3,ttL' + VPP=2 (auto from layout).
# 适用 fleet ≥ 8 节点 (64 GPU/replica, 16 节点 → DP=2, 8 节点 → DP=1)。
#
# Layout 选自 §A.6 验证: 16 stages → VPP=2 自动派生, 100 步 median -2.6% vs decoder-first/last。
# 替换 decoder-first/last 路径 (43 layer + decoder-first/last + VPP 整除约束无解, §6.5)。

export PRESET_TP=8
export PRESET_PP=8
export PRESET_CP=1
export PRESET_EP=8
export PRESET_ETP=1

export PRESET_PIPELINE_LAYOUT='Ett|(ttt|)*11,(tt|)*3,ttL'

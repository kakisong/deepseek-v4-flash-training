#!/usr/bin/env bash
# Scale: TP=8 PP=7 CP=3 EP=8 ETP=1 = 168 GPU/replica。
#
# 面向 134K SFT 的 42 节点 H200 通信削减探测。在 336 GPU 的
# actor 池上会得到 DP=2: TP 保持节点内,PP 维持 7 个 stage,
# CP 则从 cp6 减半到 cp3。对 134136 的序列长度,这需要
# HW_MAX_TOKENS_PER_GPU >= 44712;可使用 no-offload mem workload 的 49152 上限。
#
# 这是用更高的 activation/attention 显存和一次 DP=2 梯度 all-reduce,
# 换取更少的 CP 通信。长时间运行前请先 smoke。
export PRESET_TP=8
export PRESET_PP=7
export PRESET_CP=3
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_PIPELINE_LAYOUT='Et*6|t*6|t*6|t*6|t*6|t*6|t*7L'

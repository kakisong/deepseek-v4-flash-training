#!/usr/bin/env bash
# Scale: TP=8 PP=7 CP=3 EP=8 ETP=1 = 168 GPU/replica.
#
# 42-node H200 communication-reduction probe for 134K SFT. With a 336-GPU
# actor pool this gives DP=2: TP stays intra-node, PP stays at 7 stages, and
# CP is halved from cp6 to cp3. For 134136 sequence length this needs
# HW_MAX_TOKENS_PER_GPU >= 44712; use the no-offload mem workload's 49152 cap.
#
# This trades less CP communication for higher activation/attention memory and
# a DP=2 gradient all-reduce. Smoke before using for a long run.
export PRESET_TP=8
export PRESET_PP=7
export PRESET_CP=3
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_PIPELINE_LAYOUT='Et*6|t*6|t*6|t*6|t*6|t*6|t*7L'

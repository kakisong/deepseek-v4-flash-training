#!/usr/bin/env bash
# Scale: TP=8 PP=8 CP=2 EP=8 ETP=1 = 128 GPU/replica。
# 16 节点 H20 128K DP=1 shape。保持 TP=8 在节点内,128K context 下使用 CP=2
# 搭配 max_tokens_per_gpu=65536。与 12 节点的
# TP8 PP6 CP2 smoke shape 相比,PP=8 是最接近的、能被 16 节点整除的变体。

export PRESET_TP=8
export PRESET_PP=8
export PRESET_CP=2
export PRESET_EP=8
export PRESET_ETP=1

# 43 层 decoder 通过已验证的 16-stage layout 分布到 8 个物理 pipeline stage;
# Megatron 由 layout_stages / PP 推导出 VPP=2。
export PRESET_PIPELINE_LAYOUT='Ett|(ttt|)*11,(tt|)*3,ttL'

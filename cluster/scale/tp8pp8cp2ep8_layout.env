#!/usr/bin/env bash
# Scale: TP=8 PP=8 CP=2 EP=8 ETP=1 = 128 GPU/replica.
# 16-node H20 128K DP=1 shape. This keeps TP=8 intra-node and uses CP=2
# with max_tokens_per_gpu=65536 for 128K context. Compared with the 12-node
# TP8 PP6 CP2 smoke shape, PP=8 is the nearest 16-node-divisible variant.

export PRESET_TP=8
export PRESET_PP=8
export PRESET_CP=2
export PRESET_EP=8
export PRESET_ETP=1

# 43 decoder layers over 8 physical pipeline stages via the validated
# 16-stage layout; Megatron derives VPP=2 from layout_stages / PP.
export PRESET_PIPELINE_LAYOUT='Ett|(ttt|)*11,(tt|)*3,ttL'

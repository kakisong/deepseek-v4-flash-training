#!/usr/bin/env bash
# Scale: TP=2 × PP=16 × CP=4 × EP=8 ETP=1 = 128 GPU/replica。
# 64K context on 16 节点 H20: PP=16 让 Adam state 切到极小,CP=4 把 64K seq 切成 16K/CP-rank,
# TP=2 让每 rank head 数足够 sparse-MLA 跑动。
#
# 复用 prod 16-stage layout: 'Ett|(ttt|)*11,(tt|)*3,ttL'。PP=16 时 stages_in_layout/PP=1, VPP=1。

export PRESET_TP=2
export PRESET_PP=16
export PRESET_CP=4
export PRESET_EP=8
export PRESET_ETP=1

export PRESET_PIPELINE_LAYOUT='Ett|(ttt|)*11,(tt|)*3,ttL'

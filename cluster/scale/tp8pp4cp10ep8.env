#!/usr/bin/env bash
# Scale: TP=8 PP=4 CP=10 EP=8 ETP=1 = 320 GPU/replica = 40 nodes (DP1).
#
# The "fill 40 nodes via high CP" comparison point. CP=10 gives per-rank seq 25.6K — BELOW
# the ~32K MFU-saturation knee (doc §11), so predicted ~17-18% (a worse use of 40 nodes than
# PP8 CP5). Measured to confirm the knee holds at PP4 and to bound the high-CP DP1 path.
# 43 decoder layers over 4 stages as 11/11/11/10 (same as tp8pp4cp8ep8).
# Requires seq divisible by 2*CP=20 -> use --seq-length 262400 --max-tokens-per-gpu 26240.
export PRESET_TP=8
export PRESET_PP=4
export PRESET_CP=10
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_DECODER_FIRST_PIPELINE_NUM_LAYERS=11
export PRESET_DECODER_LAST_PIPELINE_NUM_LAYERS=10

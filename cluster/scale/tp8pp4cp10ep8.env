#!/usr/bin/env bash
# Scale: TP=8 PP=4 CP=10 EP=8 ETP=1 = 320 GPU/replica = 40 节点 (DP1)。
#
# “用高 CP 填满 40 节点”的对照点。CP=10 给出每 rank seq 25.6K——低于
# ~32K 的 MFU 饱和拐点 (文档 §11),因此预测只有 ~17-18% (对 40 节点的利用不如
# PP8 CP5)。实测用于确认该拐点在 PP4 下仍成立,并为高 CP 的 DP1 路线划定边界。
# 43 层 decoder 按 11/11/11/10 分到 4 个 stage (与 tp8pp4cp8ep8 相同)。
# 要求 seq 能被 2*CP=20 整除 -> 使用 --seq-length 262400 --max-tokens-per-gpu 26240。
export PRESET_TP=8
export PRESET_PP=4
export PRESET_CP=10
export PRESET_EP=8
export PRESET_ETP=1
export PRESET_DECODER_FIRST_PIPELINE_NUM_LAYERS=11
export PRESET_DECODER_LAST_PIPELINE_NUM_LAYERS=10

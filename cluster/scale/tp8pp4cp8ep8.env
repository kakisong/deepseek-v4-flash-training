#!/usr/bin/env bash
# Scale: TP=8 PP=4 CP=8 EP=8 ETP=1 = 256 GPU/replica。
# H200 长上下文 (CP=8 + 256K) 用,需要 fleet >= 32 节点。

export PRESET_TP=8
export PRESET_PP=4
export PRESET_CP=8
export PRESET_EP=8
export PRESET_ETP=1

export PRESET_DECODER_FIRST_PIPELINE_NUM_LAYERS=11
export PRESET_DECODER_LAST_PIPELINE_NUM_LAYERS=10

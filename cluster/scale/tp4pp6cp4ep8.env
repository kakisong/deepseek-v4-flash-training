#!/usr/bin/env bash
# Scale: TP=4 PP=6 CP=4 EP=8 ETP=1 = 96 GPU/replica.
# Conservative 12-node H20 128K fallback. It keeps the validated PP=6 layout
# from the 256K probe, but halves CP and doubles TP for 128K data.

export PRESET_TP=4
export PRESET_PP=6
export PRESET_CP=4
export PRESET_EP=8
export PRESET_ETP=1

# 43 decoder layers over 6 physical pipeline stages: 7/7/7/7/7/8.
export PRESET_PIPELINE_LAYOUT='Et*7|t*7|t*7|t*7|t*7|t*8L'

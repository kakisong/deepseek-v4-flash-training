#!/usr/bin/env bash
# Scale: TP=4 PP=6 CP=4 EP=8 ETP=1 = 96 GPU/replica。
# 保守的 12 节点 H20 128K 回退方案。沿用 256K 探测中已验证的 PP=6 layout,
# 但针对 128K 数据把 CP 减半、TP 翻倍。

export PRESET_TP=4
export PRESET_PP=6
export PRESET_CP=4
export PRESET_EP=8
export PRESET_ETP=1

# 43 层 decoder 分布到 6 个物理 pipeline stage: 7/7/7/7/7/8。
export PRESET_PIPELINE_LAYOUT='Et*7|t*7|t*7|t*7|t*7|t*8L'

#!/usr/bin/env bash
# Scale: TP=2 PP=6 CP=8 EP=8 ETP=1 = 96 GPU/replica。
# 12 节点 H20 256K 探测 shape: CP=8 让每个 CP rank 分到 32K token。

export PRESET_TP=2
export PRESET_PP=6
export PRESET_CP=8
export PRESET_EP=8
export PRESET_ETP=1

# 43 层 decoder 分布到 6 个物理 pipeline stage: 7/7/7/7/7/8。
export PRESET_PIPELINE_LAYOUT='Et*7|t*7|t*7|t*7|t*7|t*8L'

#!/usr/bin/env bash
# Scale: TP=2 PP=6 CP=8 EP=8 ETP=1 = 96 GPU/replica.
# 12-node H20 256K probe shape: CP=8 gives 32K tokens per CP rank.

export PRESET_TP=2
export PRESET_PP=6
export PRESET_CP=8
export PRESET_EP=8
export PRESET_ETP=1

# 43 decoder layers over 6 physical pipeline stages: 7/7/7/7/7/8.
export PRESET_PIPELINE_LAYOUT='Et*7|t*7|t*7|t*7|t*7|t*8L'

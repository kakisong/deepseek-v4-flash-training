#!/usr/bin/env bash
# Default hardware parameters for H200 (141 GB HBM3e, ~989 TFLOPs BF16, 4.8 TB/s, 132 SMs).
# Relative to H20: 1.47x memory, 1.2x bandwidth, 6.7x BF16 throughput.
#
# Sourced by run.sh before presets/*. Any preset can override individual values.
export HW_GPU_PEAK_TFLOPS_BF16=989

# Per-GPU (per CP-rank) token cap. H200 has plenty of memory; default 16K (vs H20's 4K).
# Long-context presets may push this to 32K.
export HW_MAX_TOKENS_PER_GPU=16384

# Recompute: H200 has both compute and memory headroom; default to selective (recompute attention only).
# Bump to full if still OOM; drop entirely if memory is plentiful.
export HW_RECOMPUTE_GRANULARITY=selective
export HW_RECOMPUTE_METHOD=
export HW_RECOMPUTE_NUM_LAYERS=

# FP8 training: H200 FP8 throughput ~1979 TF gives a theoretical 2x over BF16.
# The tilelang sparse-MLA *attention* kernel still consumes BF16, but TE blockwise
# FP8 on the MoE grouped GEMM (the bulk of the FLOPs) works independently — see
# run.sh HW_FP8_ENABLED branch. Overridable via env for probing (HW_FP8_ENABLED=1).
export HW_FP8_ENABLED=${HW_FP8_ENABLED:-0}

# Tilelang block sizes for H200 (132 SMs, vs H20's 78).
# The V4 kernel is adaptive today; these are reserved for future hand-tuning.
export HW_TILELANG_BLOCK_H=128
export HW_TILELANG_BLOCK_SIZE=64

# NCCL tuning.
export HW_NCCL_NVLS_ENABLE=1

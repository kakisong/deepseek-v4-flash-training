#!/usr/bin/env bash
# H200 的默认硬件参数(141 GB HBM3e,约 989 TFLOPs BF16,4.8 TB/s,132 个 SM)。
# 相对 H20:1.47 倍显存、1.2 倍带宽、6.7 倍 BF16 吞吐。
#
# 由 run.sh 在 presets/* 之前 source。任何 preset 都可以覆盖个别取值。
export HW_GPU_PEAK_TFLOPS_BF16=989

# 单 GPU(单 CP-rank)token 上限。H200 显存充裕;默认 16K(H20 为 4K)。
# 长上下文 preset 可将其提升到 32K。
export HW_MAX_TOKENS_PER_GPU=16384

# Recompute:H200 在算力和显存上都有余量;默认 selective(仅重算 attention)。
# 若仍 OOM 则提升到 full;若显存充足则完全关闭。
export HW_RECOMPUTE_GRANULARITY=selective
export HW_RECOMPUTE_METHOD=
export HW_RECOMPUTE_NUM_LAYERS=

# FP8 训练:H200 的 FP8 吞吐约 1979 TF,理论上是 BF16 的 2 倍。
# tilelang sparse-MLA 的 *attention* kernel 仍然吃 BF16,但 MoE grouped GEMM
# (FLOPs 的大头)上的 TE blockwise FP8 可以独立生效——见
# run.sh 的 HW_FP8_ENABLED 分支。可通过环境变量覆盖以做试探(HW_FP8_ENABLED=1)。
export HW_FP8_ENABLED=${HW_FP8_ENABLED:-0}

# H200 的 Tilelang block 尺寸(132 个 SM,H20 为 78 个)。
# 当前 V4 kernel 为自适应;这两项留作日后手工调优。
export HW_TILELANG_BLOCK_H=128
export HW_TILELANG_BLOCK_SIZE=64

# NCCL 调优。
export HW_NCCL_NVLS_ENABLE=1

#!/usr/bin/env bash
# Default hardware parameters for H20 (96 GB HBM3, ~148 TFLOPs BF16, 4.0 TB/s).
# Sourced by run.sh before presets/*. Any preset can override individual values.

# Per-GPU (per CP-rank) token cap. Safe value squeezed out of 96 GB HBM on H20.
export HW_MAX_TOKENS_PER_GPU=4096

# Recompute: switched to `none` after profiler verification (2026-05-12, see STATUS.md §5.I).
# Counterintuitive finding: on the V4 sparse-MLA path, selective/none are equivalent, and
# disabling recompute actually frees 6 GB of memory (workspace alloc > saved activations).
# step_time -9%, TFLOPS +20%.
export HW_RECOMPUTE_GRANULARITY=none
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1

# FP8 training: H20 FP8 throughput ~296 TF gives little advantage over BF16. Off by default.
export HW_FP8_ENABLED=0

# Tilelang kernel block sizes (current V4 kernel is adaptive; these two are reserved for future tuning).
export HW_TILELANG_BLOCK_H=64
export HW_TILELANG_BLOCK_SIZE=32

# NCCL tuning (enable NVL switch for H20 NVLink 4).
export HW_NCCL_NVLS_ENABLE=1

#!/usr/bin/env bash
# H20 的默认硬件参数(96 GB HBM3,约 148 TFLOPs BF16,4.0 TB/s)。
# 由 run.sh 在 presets/* 之前 source。任何 preset 都可以覆盖个别取值。

# 单 GPU(单 CP-rank)token 上限。在 H20 的 96 GB HBM 上压榨出的安全值。
export HW_MAX_TOKENS_PER_GPU=4096

# Recompute:经 profiler 验证后切换为 `none`(2026-05-12,见 STATUS.md §5.I)。
# 反直觉的发现:在 V4 sparse-MLA 路径上,selective/none 二者等价,而且
# 关闭 recompute 反而能释放 6 GB 显存(workspace 分配 > 省下的激活值)。
# step_time -9%,TFLOPS +20%。
export HW_RECOMPUTE_GRANULARITY=none
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1

# FP8 训练:H20 的 FP8 吞吐约 296 TF,相对 BF16 优势不大。默认关闭。
export HW_FP8_ENABLED=0

# Tilelang kernel 的 block 尺寸(当前 V4 kernel 为自适应;这两项留作日后调优)。
export HW_TILELANG_BLOCK_H=64
export HW_TILELANG_BLOCK_SIZE=32

# NCCL 调优(为 H20 NVLink 4 启用 NVL switch)。
export HW_NCCL_NVLS_ENABLE=1

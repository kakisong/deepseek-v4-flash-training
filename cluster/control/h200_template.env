#!/usr/bin/env bash
# H200 控制面模板——复制为 cluster/control/h200_<your-name>.env。

export V4_RAY_HEAD_IP=10.x.x.x
export V4_RAY_PORT=6379
export V4_DASHBOARD_PORT=8201

export V4_PROMETHEUS_PORT=40001
export V4_GRAFANA_PORT=7777
export V4_CADDY_PORT=8200
export V4_PUBLIC_URL=https://your-public-entry.example.com

export V4_GRAFANA_HOST=http://${V4_RAY_HEAD_IP}:${V4_GRAFANA_PORT}
export V4_PROMETHEUS_HOST=http://${V4_RAY_HEAD_IP}:${V4_PROMETHEUS_PORT}/promql
export V4_GRAFANA_IFRAME_HOST=${V4_PUBLIC_URL}/grafana

# GCS 使用的外部 Redis——留空表示不使用外部 Redis。
export V4_REDIS_HOST=
export V4_REDIS_PORT=6379
export V4_REDIS_PASSWORD=

export V4_TZ=Asia/Shanghai

# 出站代理——不需要代理时保持 unset。
# export V4_HTTP_PROXY=http://your-proxy:port
unset V4_HTTP_PROXY

#!/usr/bin/env bash
# Control plane: the persistent Ray head/job-server and web entry for the
# current H20 training cluster. This is intentionally independent from the
# per-job fleet size.

export V4_RAY_HEAD_IP=10.0.8.17
export V4_RAY_PORT=6379
export V4_DASHBOARD_PORT=8201

export V4_PROMETHEUS_PORT=40001
export V4_GRAFANA_PORT=7777
export V4_CADDY_PORT=8200
export V4_PUBLIC_URL=https://kaynzhang.woa.com

export V4_GRAFANA_HOST=http://${V4_RAY_HEAD_IP}:${V4_GRAFANA_PORT}
export V4_PROMETHEUS_HOST=http://${V4_RAY_HEAD_IP}:${V4_PROMETHEUS_PORT}/promql
export V4_GRAFANA_IFRAME_HOST=${V4_PUBLIC_URL}/grafana

# GCS external Redis is disabled for the current control plane. Reusing a shared
# Redis preserved stale Ray node records across recreations.
export V4_REDIS_HOST=
export V4_REDIS_PORT=6379
export V4_REDIS_PASSWORD=

export V4_HTTP_PROXY=http://172.26.0.3:8081
export V4_TZ=Asia/Shanghai

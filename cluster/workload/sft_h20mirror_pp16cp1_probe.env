#!/usr/bin/env bash
# H20-mirror MFU probe, variant 2: TP8 PP16 CP1 EP8 on 16 nodes, NO offload.
# Rationale: the PP4CP4+offload mirror (variant 1) crashed on H200 k8s node host
# limits (shared 100GB local NVMe + host RAM) -- offloading ~11 layers/stage of
# 284B optimizer state overflowed. PP16 -> ~2-3 layers/stage, and activation is
# bounded by max_tokens_per_gpu (not CP), so this fits WITHOUT offload, and removes
# CP entirely -> cleanest test of whether CP ring-comm is the MFU drain vs the
# 42-node PP7/CP6 baseline (11% MFU).
#
# Launch:
#   V4_CONTROL=h200_main V4_FLEET=h200_k8s_16node V4_SCALE=tp8pp16ep8_layout \
#     V4_WORKLOAD=sft_h20mirror_pp16cp1_probe bash run.sh
export PRESET_NAME=sft_h20mirror_pp16cp1_probe
export PRESET_RUN_ID_PREFIX=stageH20mirror-PP16CP1-H200
export PRESET_NUM_ROLLOUT=20
export PRESET_DEBUG_TRAIN_ONLY=1
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=1000
export PRESET_SAVE_RETAIN_INTERVAL=1000
export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32
export PRESET_ATTN_IMPL=tilelang
export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=cosine
export PRESET_LR_WARMUP_ITERS=2
export PRESET_USE_WANDB=1
export PRESET_WANDB_PROJECT=v4-flash-post
export PRESET_WANDB_TEAM=kaynzhang-none
export PRESET_WANDB_API_KEY_FILE=${PRESET_WANDB_API_KEY_FILE:-$V4_WORK/.secrets/wandb_api_key}
export V4_SFT_DATA=$V4_DATA/albaliang_077_le128k.jsonl
export PRESET_TOOL_KEY=tools
export HW_SEQ_LENGTH=131208
export HW_MAX_TOKENS_PER_GPU=32768
export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1
# NO offload: PP16 keeps per-stage weights/optimizer small enough to stay on-GPU.
export PRESET_CPU_OFFLOAD_FLAGS=""
# Banked validated wins.
export PRESET_MANUAL_GC=1
export PRESET_MANUAL_GC_INTERVAL=10
export PRESET_MOE_FUSION=1
export PRESET_REF_LOAD_DIR=$V4_TORCH_DIST

#!/usr/bin/env bash
# Workload: Albaliang 057 agent SFT, 3 epochs with GBS=128.
#
# Performance-oriented 12-node H20 launch, smoke-passed on 2026-06-01. The
# explicit max-tokens override is required because CP=2 needs 65536 local tokens
# for 128K:
#   bash run.sh --fleet h20_12node_6_17 --scale tp8pp6cp2ep8 --workload sft_albaliang_128k_3epoch --max-tokens-per-gpu 65536
#
# Conservative fallback, also smoke-passed:
#   bash run.sh --fleet h20_12node_6_17 --scale tp4pp6cp4ep8 --workload sft_albaliang_128k_3epoch
#
# Both shapes use all 96 H20 GPUs as one DP replica. With rollout_batch_size=
# global_batch_size=128, each rollout produces one optimizer step. Miles derives
# num_rollout as floor(dataset_size / 128) * 3.

export PRESET_NAME=sft_albaliang_128k_3epoch
export PRESET_RUN_ID_PREFIX=stageAlb128K-3ep-H20

export PRESET_NUM_EPOCH=3
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=100
export PRESET_SAVE_RETAIN_INTERVAL=500

export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32

export PRESET_ATTN_IMPL=tilelang

export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=cosine
export PRESET_LR_WARMUP_ITERS=20

export V4_SFT_DATA=$V4_DATA/albaliang_057_le128k.jsonl
export PRESET_TOOL_KEY=tools

# Default fits the conservative CP=4 shape: CP=4 x 32768 = 131072 total context
# budget. For tp8pp6cp2ep8, override this to 65536 as shown above. The current
# observed data max among records with token_length is 127987.
export HW_MAX_TOKENS_PER_GPU=32768

export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1

# Continue from the previous 64K real-data Miles checkpoint.
export PRESET_REF_LOAD_DIR=/data_train/kaynzhang/v4-sft/outputs/stageAlb16PP16-64KrealTP4-20260525-214109/checkpoints

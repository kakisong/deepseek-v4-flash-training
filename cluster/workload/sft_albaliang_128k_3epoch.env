#!/usr/bin/env bash
# Workload: Albaliang 057 agent SFT, GBS=128 跑 3 个 epoch。
#
# 目前观测最优的 16 节点 H20 启动方式。128K 下 CP=4 需要 32768 个本地 token:
#   bash run.sh --fleet h20_16node --scale tp8pp4cp4ep8 --workload sft_albaliang_128k_3epoch --max-tokens-per-gpu 32768 --no-save-optim
#
# 2026-06-02 smoke: actor_train_time=748.6s, step_time=783.6s, peak GRAM
# ~=85.5GB。TP8PP4CP2 能进入训练但峰值接近 97.8GB;TP8PP8CP1 直接 OOM。
#
# 选定的 16 节点 shape 把 128 张 H20 GPU 作为一个 DP 副本。在
# rollout_batch_size = global_batch_size = 128 时, 每个 rollout 产生一次
# optimizer step。Miles 按 floor(dataset_size / 128) * 3 推导 num_rollout。

export PRESET_NAME=sft_albaliang_128k_3epoch
export PRESET_RUN_ID_PREFIX=stageAlb128K-3ep-H20

export PRESET_NUM_EPOCH=3
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=100
export PRESET_SAVE_RETAIN_INTERVAL=500

export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32

export PRESET_ATTN_IMPL=tilelang

export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=cosine
export PRESET_LR_WARMUP_ITERS=20

export PRESET_USE_WANDB=1
export PRESET_WANDB_PROJECT=v4-flash-post
export PRESET_WANDB_TEAM=kaynzhang-none
export PRESET_WANDB_API_KEY_FILE=${PRESET_WANDB_API_KEY_FILE:-$V4_WORK/.secrets/wandb_api_key}

export V4_SFT_DATA=$V4_DATA/albaliang_057_le128k.jsonl
export PRESET_TOOL_KEY=tools

# 默认值适配选定的 CP=4 shape: CP=4 x 32768 = 131072 总上下文
# 预算。当前在带 token_length 字段的记录中观测到的数据最大值为
# 127987。
export HW_MAX_TOKENS_PER_GPU=32768

export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1

# 从原始 DeepSeek-V4-Flash torch distributed checkpoint 初始化。
export PRESET_REF_LOAD_DIR=$V4_TORCH_DIST

#!/usr/bin/env bash
# Workload: 生产 SFT 长跑配置。Recompute=none(default), DeepEP, fp32 router, layout+VPP。
# 默认 200 步 (~47 min @ tilelang 14s/step on H20 64-GPU)。
# 长跑 override: bash run.sh ... --num-rollout 1600   (~6.3h)

export PRESET_NAME=sft_prod
export PRESET_RUN_ID_PREFIX=stageProd

export PRESET_NUM_ROLLOUT=200
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=50
export PRESET_SAVE_RETAIN_INTERVAL=200

# DeepEP backend + fp32 router (50 步 × 3 SM sweep median -5.2% vs alltoall+bf16)
export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32

export PRESET_ATTN_IMPL=tilelang

export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=constant

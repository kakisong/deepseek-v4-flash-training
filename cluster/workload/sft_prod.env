#!/usr/bin/env bash
# Workload: 生产 SFT 长跑配置 (16 节点 PP=16 winner, 2026-05-22, WRITEUP §4.18)。
#
# 默认 200 步 @ 5.23s/step 稳定零漂移。长跑 override:
#   --num-rollout 2000   (~2.9h, 真长跑生产)
#
# 推荐组合 (winner):
#   bash run.sh --fleet h20_16node --scale tp8pp16ep8_layout --workload sft_prod
#   step median 5.23s, peak ~30 GB / 95 GB headroom, H4 真正解锁
#
# 8 节点 fallback (cluster 缩水):
#   bash run.sh --fleet h20_8node --scale tp8pp8ep8_layout --workload sft_prod_8node
#   step median 10.88s (cpu-offload 必开,DP=1 PP=8 关 offload 撞 OOM 见 §4.17)
#
# 关键开关:
#   - DeepEP backend + fp32 router (§4.16, -5.2% 稳定)
#   - recompute=none (默认, §4.4 H3, 4K 上 -9% step / +20% TFLOPS / -6 GB peak)
#   - cpu-offload OFF (§4.18, PP=16 让 Adam 切到 ~2.5 GB/rank, 关掉再 -11.3%)
# 16 stages layout + PP=16 时 VPP=1 自动 (§A.6, §4.18.2)

export PRESET_NAME=sft_prod
export PRESET_RUN_ID_PREFIX=stageProd

export PRESET_NUM_ROLLOUT=200
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=50
export PRESET_SAVE_RETAIN_INTERVAL=200

# DeepEP backend + fp32 router (50 步 × 3 SM sweep median -5.2% vs alltoall+bf16, §4.16)
export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32

export PRESET_ATTN_IMPL=tilelang

export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=constant

# 关 cpu-offload (PP=16 默认 winning, §4.18)。8 节点 fallback 用 sft_prod_8node 保留 offload。
export PRESET_CPU_OFFLOAD_FLAGS=""

#!/usr/bin/env bash
# Workload: 256K context training probe on H20.
# Uses the previous miles 64K real SFT checkpoint as the initial actor weights.

export PRESET_NAME=sft_256k_probe
export PRESET_RUN_ID_PREFIX=stageLC256K-H20

export PRESET_NUM_ROLLOUT=1
export PRESET_GLOBAL_BATCH_SIZE=4
export PRESET_ROLLOUT_BATCH_SIZE=4
export PRESET_SAVE_INTERVAL=100
export PRESET_SAVE_RETAIN_INTERVAL=100

export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32

export PRESET_ATTN_IMPL=tilelang

export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=constant

export V4_SFT_DATA=/data_train/kaynzhang/v4-sft/agent-sft/probe_256k_fit_sft.jsonl

# CP=8 x 32768 = 262144 total context budget.
export HW_MAX_TOKENS_PER_GPU=32768

export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1

export PRESET_REF_LOAD_DIR=/data_train/kaynzhang/v4-sft/outputs/stageAlb16PP16-64KrealTP4-20260525-214109/checkpoints

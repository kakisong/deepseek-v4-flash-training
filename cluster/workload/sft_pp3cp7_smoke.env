#!/usr/bin/env bash
# Workload: TP8/PP3/CP7 throughput+memory SMOKE on 128K data (a few steps, no save).
#
# Purpose: answer the exploratory question — does PP3 + CP7 (per-rank seq ~18.7K) FIT
# under full/uniform/1 recompute despite PP3's heavy per-stage weights (14-15 layers),
# and what is the step_time / PP bubble vs the PP7/CP6 baseline (~123s/step at 128K)?
#   - If it OOMs at step 1 -> CP7 too aggressive for PP3; fall back to tp8pp3cp14ep8.
#   - If it fits -> compare step_time to PP7CP6; PP3 should shrink the ~16% bubble.
#
# Pair with: --scale tp8pp3cp7ep8 --fleet h200_k8s_42node (=> DP2 on 336 GPU; DP2 dilutes
# PP3's bubble ~5%->~8%. For a clean DP1 bubble read you'd need a 21-node fleet.)
#
# Random init (REF_LOAD=none, run.sh throughput-probe shortcut) so it starts in ~1 min
# instead of ~15 min of iter_1164 load; weights are allocated either way so memory peak
# is representative. NUM_ROLLOUT=6 = step 1 autotune (slow, tilelang on new shapes) + steps
# 2-6 steady -> read steady step_time from steps 4-6. SAVE effectively off.

export PRESET_NAME=sft_pp3cp7_smoke
export PRESET_RUN_ID_PREFIX=probePP3CP7-128K-H200
export PRESET_NUM_ROLLOUT=6
export PRESET_DEBUG_TRAIN_ONLY=0
export PRESET_DUMP_DETAILS=0
export PRESET_GLOBAL_BATCH_SIZE=128       # realistic GBS so microbatch count / bubble are representative
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=100000        # never save in 6 steps
export PRESET_SAVE_RETAIN_INTERVAL=100000
export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32
export PRESET_ATTN_IMPL=tilelang
export PRESET_CPU_OFFLOAD_FLAGS=""
export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=constant
export PRESET_LR_WARMUP_ITERS=0
export PRESET_USE_WANDB=0                  # smoke: no wandb
export V4_SFT_DATA=$V4_DATA/albaliang_077_le128k.jsonl
export PRESET_TOOL_KEY=tools
export HW_SEQ_LENGTH=131208                # 128K (multiple of 2*CP7=14: 131208/14=9372)
export HW_MAX_TOKENS_PER_GPU=18744         # 18744*7 = 131208 => a full 128K sample fits as a singleton microbatch
export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1
export PRESET_REF_LOAD_DIR=none            # random init (fast start; memory peak still representative)

export PRESET_MANUAL_GC=1
export PRESET_MANUAL_GC_INTERVAL=10
export PRESET_MOE_FUSION=1
export PRESET_ASYNC_ROLLOUT_PREFETCH=1

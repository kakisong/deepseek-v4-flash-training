#!/usr/bin/env bash
# 工作负载:在 128K 数据上做 TP8/PP3/CP7 吞吐+显存 SMOKE(只跑几步,不保存)。
#
# 目的:回答探索性问题——PP3 + CP7(每 rank 序列约 18.7K)在 full/uniform/1 重计算下,
# 尽管 PP3 每个 stage 的权重较重(14-15 层),是否放得下?
# 以及相对 PP7/CP6 基线(128K 下约 123s/step)的 step_time / PP 气泡如何?
#   - 若第 1 步就 OOM -> 对 PP3 而言 CP7 太激进;回退到 tp8pp3cp14ep8。
#   - 若放得下 -> 与 PP7CP6 比较 step_time;PP3 应能缩小约 16% 的气泡。
#
# 搭配使用:--scale tp8pp3cp7ep8 --fleet h200_k8s_42node(=> 336 GPU 上为 DP2;DP2 会把
# PP3 的气泡从约 5% 稀释到约 8%。要干净地读出 DP1 气泡需要 21 节点的 fleet。)
#
# 随机初始化(REF_LOAD=none,run.sh 的吞吐 probe 捷径),约 1 分钟即可启动,
# 而不必花约 15 分钟加载 iter_1164;两种方式权重都会分配,因此显存峰值
# 具有代表性。NUM_ROLLOUT=6 = 第 1 步 autotune(慢,tilelang 处理新形状)+ steps
# 2-6 稳态 -> 稳态 step_time 取 steps 4-6 的读数。SAVE 实际等于关闭。

export PRESET_NAME=sft_pp3cp7_smoke
export PRESET_RUN_ID_PREFIX=probePP3CP7-128K-H200
export PRESET_NUM_ROLLOUT=6
export PRESET_DEBUG_TRAIN_ONLY=0
export PRESET_DUMP_DETAILS=0
export PRESET_GLOBAL_BATCH_SIZE=128       # 使用真实 GBS,使 microbatch 数量 / 气泡具有代表性
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=100000        # 6 步内不会触发保存
export PRESET_SAVE_RETAIN_INTERVAL=100000
export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32
export PRESET_ATTN_IMPL=tilelang
export PRESET_CPU_OFFLOAD_FLAGS=""
export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=constant
export PRESET_LR_WARMUP_ITERS=0
export PRESET_USE_WANDB=0                  # smoke:不使用 wandb
export V4_SFT_DATA=$V4_DATA/albaliang_077_le128k.jsonl
export PRESET_TOOL_KEY=tools
export HW_SEQ_LENGTH=131208                # 128K(2*CP7=14 的倍数:131208/14=9372)
export HW_MAX_TOKENS_PER_GPU=18744         # 18744*7 = 131208 => 完整的 128K 样本可作为单条 microbatch 放下
export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1
export PRESET_REF_LOAD_DIR=none            # 随机初始化(启动快;显存峰值仍有代表性)

export PRESET_MANUAL_GC=1
export PRESET_MANUAL_GC_INTERVAL=10
export PRESET_MOE_FUSION=1
export PRESET_ASYNC_ROLLOUT_PREFETCH=1

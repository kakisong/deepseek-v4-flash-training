#!/usr/bin/env bash
# 64K PP=16 关 cpu-offload —— 上一档 sft_64k_pp16(offload+recompute=full)实测 peak used 47.7 GB,
# free 47 GB,Adam 拉回 GPU(+~2.5 GB/rank,PP=16 切完已很小)估测 peak ~50 GB,余量足够。
# 保留 recompute=full —— 32K shape 验证关 recompute 直接 OOM(WRITEUP §4.18.6),64K 同样保留。

export PRESET_NAME=sft_64k_pp16_no_offload
export PRESET_RUN_ID_PREFIX=stageAlb16PP16-64K-NoOff

export PRESET_NUM_ROLLOUT=20
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=100
export PRESET_SAVE_RETAIN_INTERVAL=100

export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32

export PRESET_ATTN_IMPL=tilelang

export PRESET_LR=1e-5
export PRESET_LR_DECAY_STYLE=cosine
export PRESET_LR_WARMUP_ITERS=10

export V4_SFT_DATA=$V4_DATA/albaliang_057_le32k.jsonl
export PRESET_TOOL_KEY=tools

export HW_MAX_TOKENS_PER_GPU=16384

export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1

export PRESET_CPU_OFFLOAD_FLAGS=""

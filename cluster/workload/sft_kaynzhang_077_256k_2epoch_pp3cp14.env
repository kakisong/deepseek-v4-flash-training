#!/usr/bin/env bash
# 工作负载:kaynzhang_077 256K SFT,2 个 epoch——PP3/CP14 变体(减少流水线气泡的 probe)。
#
# 数据 / 初始化 / LR / 2-epoch 与 sft_kaynzhang_077_256k_2epoch 相同,但目标是
# tp8pp3cp14ep8 规格(TP8 PP3 CP14 EP8 = 336 = 42 节点,DP1):
#   - PP3 大幅压缩流水线气泡(PP7 在约 51 个 microbatch 时约 12% -> PP3 约 3-4%)。
#   - CP14 -> 每 rank 序列约 18.7K -> 激活极低,因此 PP3 每个 stage 更重的
#     权重(14-15 层)仍能轻松放下(实测 PP7/CP6 峰值仅
#     64% / 89GB,对 PP3 多出的约 14GB 权重基线还有约 50GB 余量)。
# 启动方式:--scale tp8pp3cp14ep8 --workload sft_kaynzhang_077_256k_2epoch_pp3cp14
#
# 验证目标(对比在跑的 PP7/CP6 训练:稳态约 250s/step,MFU 17.6%,峰值 64%):
#   PP3 是否放得下(应该可以)?更小的气泡能否降低 step_time?更快则保留,
#   OOM 或退化则回退到 PP7/CP6。重计算保持 full/uniform/1,以便单独考察
#   PP 并行度的影响(CP14 的极小激活之后也可能允许更轻的重计算)。

export PRESET_NAME=sft_kaynzhang_077_256k_2epoch_pp3cp14
export PRESET_RUN_ID_PREFIX=stageKaynzhang077-256K-2ep-PP3CP14-H200
export PRESET_NUM_EPOCH=2
export PRESET_DEBUG_TRAIN_ONLY=0
export PRESET_DUMP_DETAILS=0
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=100
export PRESET_SAVE_RETAIN_INTERVAL=500
export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32
export PRESET_ATTN_IMPL=tilelang
export PRESET_CPU_OFFLOAD_FLAGS=""
export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=cosine
export PRESET_LR_WARMUP_ITERS=20
export PRESET_USE_WANDB=1
export PRESET_WANDB_PROJECT=v4-flash-post
export PRESET_WANDB_TEAM=kaynzhang-none
export PRESET_WANDB_API_KEY_FILE=${PRESET_WANDB_API_KEY_FILE:-$V4_WORK/.secrets/wandb_api_key}
export V4_SFT_DATA=$V4_DATA/albaliang_077_256k_v4_le256k.jsonl
export PRESET_TOOL_KEY=tools
# seq_length 是 2*CP14 = 28 的倍数:262416/28 = 9372(整除)。max_tokens*14 = 262416 = seq,
# 因此完整的 256K 样本能作为单条 microbatch 放下。
export HW_SEQ_LENGTH=262416
export HW_MAX_TOKENS_PER_GPU=18744
export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1
export PRESET_REF_LOAD_DIR=$V4_OUT/stageKaynzhang077-134K-3ep-H200-20260606-172101/checkpoints

export PRESET_MANUAL_GC=1
export PRESET_MANUAL_GC_INTERVAL=10
export PRESET_MOE_FUSION=1
export PRESET_ASYNC_ROLLOUT_PREFETCH=1

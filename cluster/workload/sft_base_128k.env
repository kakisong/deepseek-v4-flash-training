#!/usr/bin/env bash
# ============================================================================
#  V4-Flash 128K SFT 基线模板  (PP4 CP4 / per-rank 32768 = ~32K 拐点)
#  依据: docs/h200_bottleneck_analysis.md §11 —— per-rank 32768 与已实测的
#        PP4 CP8 @256K(per-rank 32802 -> 19.4% MFU) 是同一个点(同 PP4 同 per-rank)。
#        内存 ~73% 安全; selective recompute 在 128K 会 OOM(§8), 故用 full/uniform/1。
#
#  用法: 复制本文件 -> 改下面【必填】4 行 -> 跑(二选一):
#    DP2(32 节点, 吞吐翻倍):  bash run.sh --fleet h200_k8s_32node --scale tp8pp4cp4ep8 --workload <本文件名>
#    DP1(16 节点, 省机器):    bash run.sh --fleet h200_k8s_16node --scale tp8pp4cp4ep8 --workload <本文件名>
#  (per-GPU 效率两者相同; DP2 只是用更多机器换更短墙钟。seq/max-tokens 已写死。)
# ============================================================================

# ======================= 【必填】每次换数据改这 4 行 =======================
export V4_SFT_DATA="$V4_DATA/换成你的数据文件.jsonl"   # V4 messages 格式 -> --prompt-data
                                                      # (原始 albaliang 格式先过 tools/jsonl_to_v4_dataset.py)
export PRESET_RUN_ID_PREFIX="stage128K-改成本次任务名"  # 输出目录 / wandb group 前缀, 务必每次改(否则难区分)
export PRESET_REF_LOAD_DIR="$V4_TORCH_DIST"           # 初始权重: 底座重训=$V4_TORCH_DIST
                                                      #           续训=某 run 的 .../checkpoints
export PRESET_NUM_EPOCH=3                              # 训练轮数
# ==========================================================================

# ---- 以下为 PP4 CP4 生产值, 一般不动 ----
export PRESET_NAME=sft_base_128k
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=100
export PRESET_SAVE_RETAIN_INTERVAL=500

# seq 必须 >= 最长样本 且 能被 2*CP(=8) 整除; 131072 对应 <=128K 数据。
# ⚠️ 单样本需 <= max_tokens*CP = 32768*4 = 131072 才能装下(CP4 余量很紧):
#    若你的数据有样本接近/超过 128K, 改用 256K 模板(CP5, 上限 250K)。
export HW_SEQ_LENGTH=131072
export HW_MAX_TOKENS_PER_GPU=32768
export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1

# 已验证标准开关(EP8/DeepEP, fp32 router, tilelang, 关 offload, 手动 GC, permute-fusion, rollout 预取)
export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32
export PRESET_ATTN_IMPL=tilelang
export PRESET_CPU_OFFLOAD_FLAGS=""
export PRESET_MANUAL_GC=1
export PRESET_MANUAL_GC_INTERVAL=10
export PRESET_MOE_FUSION=1
export PRESET_ASYNC_ROLLOUT_PREFETCH=1
export PRESET_TOOL_KEY=tools   # agent-SFT 的 tools 字段 -> --tool-key; 非工具数据可留空

# 学习率
export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=cosine
export PRESET_LR_WARMUP_ITERS=20

# wandb
export PRESET_USE_WANDB=1
export PRESET_WANDB_PROJECT=v4-flash-post
export PRESET_WANDB_TEAM=kaynzhang-none
export PRESET_WANDB_API_KEY_FILE=${PRESET_WANDB_API_KEY_FILE:-$V4_WORK/.secrets/wandb_api_key}

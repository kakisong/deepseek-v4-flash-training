#!/usr/bin/env bash
# Workload: PP3 CP-scan SMOKE on 256K data — maps MFU vs per-rank sequence length.
#
# One workload, launched 3x with --scale + --max-tokens-per-gpu overrides (all DP1):
#   CP4  : --fleet h200_k8s_12node --scale tp8pp3cp4ep8  --max-tokens-per-gpu 65604  (per-rank ~64K, 12 nodes)
#   CP7  : --fleet h200_k8s_21node --scale tp8pp3cp7ep8  --max-tokens-per-gpu 37488  (per-rank ~37.5K, 21 nodes)
#   CP14 : --fleet h200_k8s_42node --scale tp8pp3cp14ep8 --max-tokens-per-gpu 18744  (per-rank ~18.7K, 42 nodes)
# token_cap = max_tokens*CP = 262416 = seq in all three (a 256K sample fits as a singleton).
#
# Goal: per-GPU MFU (actor_train_tflops/989) at each per-rank seq, + peak mem + bubble.
# Combined with the live PP7/CP6 point (per-rank 43.7K -> MFU 17.6%) this draws the
# MFU-vs-per-rank-seq curve and shows where it saturates / where memory OOMs.
#
# Random init (REF_LOAD=none) -> starts in ~1min, weights still allocated so memory peak is
# representative. NUM_ROLLOUT=6 -> step0 = tilelang autotune (slow, new shape), steps 2-5 steady.
# SAVE off. Read steady MFU from steps 4-5.

export PRESET_NAME=sft_pp3_scan_smoke
export PRESET_RUN_ID_PREFIX=probePP3scan-256K-H200
export PRESET_NUM_ROLLOUT=6
export PRESET_DEBUG_TRAIN_ONLY=0
export PRESET_DUMP_DETAILS=0
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=100000
export PRESET_SAVE_RETAIN_INTERVAL=100000
export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32
export PRESET_ATTN_IMPL=tilelang
export PRESET_CPU_OFFLOAD_FLAGS=""
export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=constant
export PRESET_LR_WARMUP_ITERS=0
export PRESET_USE_WANDB=0
export V4_SFT_DATA=$V4_DATA/albaliang_077_256k_v4_le256k.jsonl
export PRESET_TOOL_KEY=tools
export HW_SEQ_LENGTH=262416                # multiple of 2*CP for CP in {4,7,14}
export HW_MAX_TOKENS_PER_GPU=18744         # default = CP14; override per CP on the CLI
export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1
# miles requires a load source (REF_LOAD=none -> assert args.load/pretrained fails). Init from
# iter_1164 (reshards TP8PP7CP6 -> PP3/CPx via dist_ckpt). +~15min load/run, but MFU is weight-independent.
export PRESET_REF_LOAD_DIR=$V4_OUT/stageKaynzhang077-134K-3ep-H200-20260606-172101/checkpoints

export PRESET_MANUAL_GC=1
export PRESET_MANUAL_GC_INTERVAL=10
export PRESET_MOE_FUSION=1
export PRESET_ASYNC_ROLLOUT_PREFETCH=1

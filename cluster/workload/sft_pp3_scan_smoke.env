#!/usr/bin/env bash
# 工作负载:在 256K 数据上做 PP3 CP 扫描 SMOKE——绘制 MFU 与每 rank 序列长度的关系。
#
# 同一个 workload,配合 --scale + --max-tokens-per-gpu 覆盖参数启动 3 次(均为 DP1):
#   CP4  : --fleet h200_k8s_12node --scale tp8pp3cp4ep8  --max-tokens-per-gpu 65604  (每 rank 约 64K,12 节点)
#   CP7  : --fleet h200_k8s_21node --scale tp8pp3cp7ep8  --max-tokens-per-gpu 37488  (每 rank 约 37.5K,21 节点)
#   CP14 : --fleet h200_k8s_42node --scale tp8pp3cp14ep8 --max-tokens-per-gpu 18744  (每 rank 约 18.7K,42 节点)
# 三种配置下 token_cap = max_tokens*CP = 262416 = seq(256K 样本可作为单条 microbatch 放下)。
#
# 目标:各每 rank 序列长度下的单 GPU MFU(actor_train_tflops/989),外加峰值显存和气泡。
# 结合在跑的 PP7/CP6 数据点(每 rank 43.7K -> MFU 17.6%),即可画出
# MFU 随每 rank 序列长度变化的曲线,并看出其在何处饱和 / 何处显存 OOM。
#
# 随机初始化(REF_LOAD=none)-> 约 1 分钟即可启动,权重仍会分配,因此显存峰值
# 具有代表性。NUM_ROLLOUT=6 -> step0 = tilelang autotune(慢,新形状),steps 2-5 为稳态。
# SAVE 关闭。稳态 MFU 取 steps 4-5 的读数。

export PRESET_NAME=sft_pp3_scan_smoke
export PRESET_RUN_ID_PREFIX=probePP3scan-256K-H200
export PRESET_NUM_ROLLOUT=6
export PRESET_DEBUG_TRAIN_ONLY=0
export PRESET_DUMP_DETAILS=0
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=100000
export PRESET_SAVE_RETAIN_INTERVAL=100000
export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32
export PRESET_ATTN_IMPL=tilelang
export PRESET_CPU_OFFLOAD_FLAGS=""
export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=constant
export PRESET_LR_WARMUP_ITERS=0
export PRESET_USE_WANDB=0
export V4_SFT_DATA=$V4_DATA/albaliang_077_256k_v4_le256k.jsonl
export PRESET_TOOL_KEY=tools
export HW_SEQ_LENGTH=262416                # 对 CP ∈ {4,7,14} 均为 2*CP 的倍数
export HW_MAX_TOKENS_PER_GPU=18744         # 默认 = CP14;各 CP 在命令行覆盖
export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1
# miles 要求提供加载来源(REF_LOAD=none -> assert args.load/pretrained 失败)。从
# iter_1164 初始化(通过 dist_ckpt 把 TP8PP7CP6 重切分为 PP3/CPx)。每次运行多约 15 分钟加载,但 MFU 与权重无关。
export PRESET_REF_LOAD_DIR=$V4_OUT/stageKaynzhang077-134K-3ep-H200-20260606-172101/checkpoints

export PRESET_MANUAL_GC=1
export PRESET_MANUAL_GC_INTERVAL=10
export PRESET_MOE_FUSION=1
export PRESET_ASYNC_ROLLOUT_PREFETCH=1

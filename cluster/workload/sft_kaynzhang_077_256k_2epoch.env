#!/usr/bin/env bash
# Workload: kaynzhang_077 256K V4 agent SFT, 2 epochs — continued SFT from the 128K run.
#
# Continues from iter_0001164 of the 134K/3-epoch run (same TP8/PP7/CP6 layout → loads
# directly, no resharding). Data is the albaliang 256K-curation 50K set, converted from
# the {tool_call-role, per-message loss} schema to V4 format via tools/jsonl_to_v4_dataset.py.
#
# 256K context strategy on the EXISTING 42-node TP8/PP7/CP6 layout (try-first per request):
#   - CP6 → max_tokens_per_gpu raised 32768→43691 so token_cap = 43691×6 = 262146 ≈ 256K,
#     letting a full 256K sample fit as a singleton microbatch.
#   - recompute full/block/4 → full/uniform/1 (recompute EVERY layer) to offset the +33%
#     per-CP-rank tokens; activation memory drops enough that PP7/CP6 may still fit.
#   - If it OOMs, fall back to scale tp8pp5cp8ep8 (40 nodes, CP8×32768=262144, lighter/GPU).

export PRESET_NAME=sft_kaynzhang_077_256k_2epoch
export PRESET_RUN_ID_PREFIX=stageKaynzhang077-256K-2ep-H200
export PRESET_NUM_EPOCH=2
export PRESET_DEBUG_TRAIN_ONLY=0
export PRESET_DUMP_DETAILS=0
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=100
export PRESET_SAVE_RETAIN_INTERVAL=500
export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32
export PRESET_ATTN_IMPL=tilelang
export PRESET_CPU_OFFLOAD_FLAGS=""
export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=cosine
export PRESET_LR_WARMUP_ITERS=20
export PRESET_USE_WANDB=1
export PRESET_WANDB_PROJECT=v4-flash-post
export PRESET_WANDB_TEAM=kaynzhang-none
export PRESET_WANDB_API_KEY_FILE=${PRESET_WANDB_API_KEY_FILE:-$V4_WORK/.secrets/wandb_api_key}
export V4_SFT_DATA=$V4_DATA/albaliang_077_256k_v4_le256k.jsonl
export PRESET_TOOL_KEY=tools
# seq_length must be a multiple of 2*CP (=12 for CP6); 262416 = 2*131208 (the 134K run's value),
# divisible by 12 and > the longest real sample (~236K; metadata max 262138 over-counts ~26K).
export HW_SEQ_LENGTH=262416
export HW_MAX_TOKENS_PER_GPU=43691
export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1

# Initial actor weights = the 128K SFT final checkpoint (iter_0001164). New RUN_ID => the
# new --load (SAVE_DIR/checkpoints) is empty, so init falls back to --ref-load (weights only,
# fresh optimizer + fresh cosine LR schedule from iter 0).
export PRESET_REF_LOAD_DIR=$V4_OUT/stageKaynzhang077-134K-3ep-H200-20260606-172101/checkpoints

# --- carried over from the 134K run (validated wins) ---
export PRESET_MANUAL_GC=1
export PRESET_MANUAL_GC_INTERVAL=10
export PRESET_MOE_FUSION=1   # permute-fusion only (router-fusion incompatible w/ sqrtsoftplus)
export PRESET_ASYNC_ROLLOUT_PREFETCH=1

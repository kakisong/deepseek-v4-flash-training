#!/usr/bin/env bash
# 工作负载:kaynzhang_077 256K V4 agent SFT,2 个 epoch——从 128K 训练继续 SFT。
#
# 从 134K/3-epoch 训练的 iter_0001164 继续(TP8/PP7/CP6 布局相同 → 可直接
# 加载,无需 resharding)。数据为 albaliang 256K 精选 50K 集,已通过 tools/jsonl_to_v4_dataset.py
# 从 {tool_call-role, per-message loss} schema 转换为 V4 格式。
#
# 在现有 42 节点 TP8/PP7/CP6 布局上的 256K 上下文策略(按需求优先尝试现有布局):
#   - CP6 → max_tokens_per_gpu 由 32768 提至 43691,使 token_cap = 43691×6 = 262146 ≈ 256K,
#     让完整的 256K 样本能作为单条 microbatch 放下。
#   - 重计算 full/block/4 → full/uniform/1(对每一层都重计算),以抵消每个 CP rank
#     +33% 的 token 量;激活显存下降足够多,PP7/CP6 可能仍然放得下。
#   - 若 OOM,则回退到 scale tp8pp5cp8ep8(40 节点,CP8×32768=262144,单 GPU 负载更轻)。

export PRESET_NAME=sft_kaynzhang_077_256k_2epoch
export PRESET_RUN_ID_PREFIX=stageKaynzhang077-256K-2ep-H200
export PRESET_NUM_EPOCH=2
export PRESET_DEBUG_TRAIN_ONLY=0
export PRESET_DUMP_DETAILS=0
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=100
export PRESET_SAVE_RETAIN_INTERVAL=500
export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32
export PRESET_ATTN_IMPL=tilelang
export PRESET_CPU_OFFLOAD_FLAGS=""
export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=cosine
export PRESET_LR_WARMUP_ITERS=20
export PRESET_USE_WANDB=1
export PRESET_WANDB_PROJECT=v4-flash-post
export PRESET_WANDB_TEAM=kaynzhang-none
export PRESET_WANDB_API_KEY_FILE=${PRESET_WANDB_API_KEY_FILE:-$V4_WORK/.secrets/wandb_api_key}
export V4_SFT_DATA=$V4_DATA/albaliang_077_256k_v4_le256k.jsonl
export PRESET_TOOL_KEY=tools
# seq_length 必须是 2*CP 的倍数(CP6 时为 12);262416 = 2*131208(134K 训练所用值),
# 可被 12 整除且大于最长真实样本(约 236K;metadata 中的最大值 262138 多算了约 26K)。
export HW_SEQ_LENGTH=262416
export HW_MAX_TOKENS_PER_GPU=43691
export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1

# actor 初始权重 = 128K SFT 最终 checkpoint(iter_0001164)。新的 RUN_ID 意味着
# 新的 --load(SAVE_DIR/checkpoints)为空,因此初始化回退到 --ref-load(仅加载权重,
# optimizer 全新初始化 + cosine LR 调度从 iter 0 重新开始)。
export PRESET_REF_LOAD_DIR=$V4_OUT/stageKaynzhang077-134K-3ep-H200-20260606-172101/checkpoints

# --- 从 134K 训练沿用(已验证有收益) ---
export PRESET_MANUAL_GC=1
export PRESET_MANUAL_GC_INTERVAL=10
export PRESET_MOE_FUSION=1   # 仅 permute 融合(router 融合与 sqrtsoftplus 不兼容)
export PRESET_ASYNC_ROLLOUT_PREFETCH=1

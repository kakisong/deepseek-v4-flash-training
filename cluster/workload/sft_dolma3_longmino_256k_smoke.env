#!/usr/bin/env bash
# Workload: 256K SFT smoke built from open Dolma3 Longmino long documents.
# Source dataset: https://huggingface.co/datasets/allenai/dolma3_longmino_pool

export PRESET_NAME=sft_dolma3_longmino_256k_smoke
export PRESET_RUN_ID_PREFIX=stageDolma3LC256K-H20

export PRESET_NUM_ROLLOUT=1
export PRESET_GLOBAL_BATCH_SIZE=4
export PRESET_ROLLOUT_BATCH_SIZE=4
export PRESET_SAVE_INTERVAL=100000
export PRESET_SAVE_RETAIN_INTERVAL=100000

export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32

export PRESET_ATTN_IMPL=tilelang

export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=constant

export V4_SFT_DATA=/data_train/kaynzhang/v4-sft/data/dolma3_longmino_256k_pseudosft_fit.jsonl

# CP=8 x 32768 = 262144 total context budget. Prepared samples render to
# 257982..258042 DeepSeek-V4 tokens, leaving a small template/scheduler margin.
export HW_MAX_TOKENS_PER_GPU=32768

export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1

export PRESET_REF_LOAD_DIR=$V4_TORCH_DIST

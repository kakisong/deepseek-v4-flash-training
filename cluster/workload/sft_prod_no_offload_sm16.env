#!/usr/bin/env bash
# 4K SM=20 (default) PP=16 关 cpu-offload winner —— 50 步 baseline (5.25s median).
# 跟 sft_prod_no_offload_sm{16,24} 配合做 SM sweep。

export PRESET_NAME=sft_prod_no_offload_sm16
export PRESET_RUN_ID_PREFIX=stageProd16PP16NoOffSM16

export PRESET_NUM_ROLLOUT=50
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=100
export PRESET_SAVE_RETAIN_INTERVAL=100

export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32
export PRESET_MOE_DEEPEP_NUM_SMS=16

export PRESET_ATTN_IMPL=tilelang

export PRESET_LR=5e-6

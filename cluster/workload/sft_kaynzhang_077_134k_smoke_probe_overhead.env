#!/usr/bin/env bash
# Workload: one-step no-offload block-recompute probe.
#
# Purpose: keep CPU offload disabled and use more H200 memory than full/uniform/1,
# without jumping all the way to selective recompute, which OOMed at 32768 tokens/GPU.

export PRESET_NAME=sft_kaynzhang_077_134k_smoke_no_offload_block4
export PRESET_RUN_ID_PREFIX=stageKaynzhang077-134K-smokeNoOffBlock4-H200
export PRESET_NUM_ROLLOUT=1
export PRESET_DEBUG_TRAIN_ONLY=1
export PRESET_DUMP_DETAILS=0
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=100000
export PRESET_SAVE_RETAIN_INTERVAL=100000
export PRESET_USE_WANDB=1
export PRESET_WANDB_PROJECT=v4-flash-post
export PRESET_WANDB_TEAM=kaynzhang-none
export PRESET_WANDB_API_KEY_FILE=${PRESET_WANDB_API_KEY_FILE:-$V4_WORK/.secrets/wandb_api_key}
export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32
export PRESET_ATTN_IMPL=tilelang
export PRESET_CPU_OFFLOAD_FLAGS=""
export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=constant
export V4_SFT_DATA=$V4_DATA/albaliang_077_le128k.jsonl
export PRESET_TOOL_KEY=tools
export HW_SEQ_LENGTH=131208
export HW_MAX_TOKENS_PER_GPU=32768
export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=block
export HW_RECOMPUTE_NUM_LAYERS=4
export PRESET_REF_LOAD_DIR=$V4_TORCH_DIST

# --- MFU probe (2026-06-05): launch-overhead reducers + (fsx) bwd-kernel + indexer edits ---
# manual-gc aligns Python GC across 336 ranks; MoE router/permute fusion cut kernel launches.
# Kernel/indexer source edits (num_stages=2/block_H=32, dead double-topk removed) are already
# applied on fsx and picked up at import; this env only toggles the Megatron flags.
export PRESET_MANUAL_GC=1
export PRESET_MANUAL_GC_INTERVAL=10
export PRESET_MOE_FUSION=1
export PRESET_RUN_ID_PREFIX=stageKaynzhang077-134K-probeOverhead-H200

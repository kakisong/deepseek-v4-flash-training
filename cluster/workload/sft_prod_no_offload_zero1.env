#!/usr/bin/env bash
# 4K PP=16 + DP=2 + ZeRO-1 + 关 cpu-offload —— 在 5.25s winner 上叠加 ZeRO-1。
#
# 上一档 sft_prod_no_offload_sm20: TP=8 PP=16 DP=1 关 offload, median 5.25s。
# 16 节点 GBS=256 → DP=2,每 stage 仍有 8 microbatch (≥ PP=16 不构成限制因为 VPP=1)。
# Adam state 进一步从 ~2.5 GB → ~1.25 GB/rank,边际省内存,但 DP=2 引入 grad allreduce + ZeRO-1
# allgather 通信开销。可能 +5% 也可能 -5%,看通信能否被 overlap。

export PRESET_NAME=sft_prod_no_offload_zero1
export PRESET_RUN_ID_PREFIX=stageProd16PP16NoOffZ1

export PRESET_NUM_ROLLOUT=50
export PRESET_GLOBAL_BATCH_SIZE=256
export PRESET_ROLLOUT_BATCH_SIZE=256
export PRESET_SAVE_INTERVAL=100
export PRESET_SAVE_RETAIN_INTERVAL=100

export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32

export PRESET_ATTN_IMPL=tilelang

export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=constant

export PRESET_USE_DIST_OPT=1
export PRESET_CPU_OFFLOAD_FLAGS=""

#!/usr/bin/env bash
# Workload: kaynzhang_077 134K V4 agent SFT, 3 个 epoch。
#
# 当前 42 节点 H200 的默认配置。采用源自 P3 的计算配置:
# TP=8 PP=7 CP=6 EP=8, 不开 CPU offload, DeepEP, router fp32,
# full/block/4 recompute, max_tokens_per_gpu=32768。

export PRESET_NAME=sft_kaynzhang_077_134k_3epoch
export PRESET_RUN_ID_PREFIX=stageKaynzhang077-134K-3ep-H200
export PRESET_NUM_EPOCH=3
export PRESET_DEBUG_TRAIN_ONLY=0
export PRESET_DUMP_DETAILS=0
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=100
export PRESET_SAVE_RETAIN_INTERVAL=500
export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32
export PRESET_ATTN_IMPL=tilelang
export PRESET_CPU_OFFLOAD_FLAGS=""
export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=cosine
export PRESET_LR_WARMUP_ITERS=20
export PRESET_USE_WANDB=1
export PRESET_WANDB_PROJECT=v4-flash-post
export PRESET_WANDB_TEAM=kaynzhang-none
export PRESET_WANDB_API_KEY_FILE=${PRESET_WANDB_API_KEY_FILE:-$V4_WORK/.secrets/wandb_api_key}
export V4_SFT_DATA=$V4_DATA/albaliang_077_le128k.jsonl
export PRESET_TOOL_KEY=tools
export HW_SEQ_LENGTH=131208
export HW_MAX_TOKENS_PER_GPU=32768
export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=block
export HW_RECOMPUTE_NUM_LAYERS=4
export PRESET_REF_LOAD_DIR=$V4_TORCH_DIST

# --- MFU 专项 2026-06-05: 验证得到 +5%(叠加在 EFA 3x 之上)。Loss 与基线一致。 ---
# kernel/indexer 源码层面的优化放在 fsx 上(sparse-MLA bwd num_stages=2, 移除 indexer 无效 topk)。
export PRESET_MANUAL_GC=1
export PRESET_MANUAL_GC_INTERVAL=10
export PRESET_MOE_FUSION=1   # 仅 permute-fusion(router-fusion 与 sqrtsoftplus 不兼容)

# --- 2026-06-06: rollout/train 重叠。SFT rollout 是纯 CPU 的数据 tokenization/打包
# (与权重无关), 但 train.py 此前是同步生成 -> 每步约 30% 的 GPU 空转 train_wait。
# 改为在当前 train step 期间预取下一个 batch。每步隐藏 ~40s -> 等效 ~1.33x。 ---
export PRESET_ASYNC_ROLLOUT_PREFETCH=1

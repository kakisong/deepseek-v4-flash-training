#!/usr/bin/env bash
# Workload: Albaliang 057 agent SFT。256k-row jsonl, 32K context (V4 token ≤ 22K)。
# tool_call schema 通过 --tool-key tools 在加载时 flatten。

export PRESET_NAME=sft_albaliang
export PRESET_RUN_ID_PREFIX=stageAlb

export PRESET_NUM_ROLLOUT=400
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=50
export PRESET_SAVE_RETAIN_INTERVAL=100

export PRESET_ATTN_IMPL=tilelang

# Cosine + 20 warmup (200 步 10%, 400 步也合理)
export PRESET_LR=1e-5
export PRESET_LR_DECAY_STYLE=cosine
export PRESET_LR_WARMUP_ITERS=20

# 32K shape 比 4K prod 显存压力大: 8K/rank × CP=4 = 32K seq → 必须 full recompute
export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1
export HW_MAX_TOKENS_PER_GPU=8192

# 数据 + tool 字段
export V4_SFT_DATA=$V4_DATA/albaliang_057_le32k.jsonl
export PRESET_TOOL_KEY=tools

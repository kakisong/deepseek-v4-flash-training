#!/usr/bin/env bash
# Workload: 64K real-data SFT, 用 TP=4 PP=16 CP=2 + max_tok=32768 = 64K seq。
# 历史: sft_64k_real (TP=2 PP=16 CP=4 + max_tok=16384) 在 fused_cross_entropy
# triton kernel 上踩 cudaErrorInvalidValue (vocab/TP=2=64640 + 16K micro-seq 组合
# 越界,2026-05-25)。改 TP=4 让 vocab/TP=32320 缓解,代价是 max_tok 翻倍 (32K micro-seq)
# 显存吃紧,保留 cpu-offload + recompute=full 兜底。
#
# 推荐: bash run.sh --fleet h20_16node --scale tp4pp16cp2ep8 --workload sft_64k_real_tp4

export PRESET_NAME=sft_64k_real_tp4
export PRESET_RUN_ID_PREFIX=stageAlb16PP16-64KrealTP4

export PRESET_NUM_ROLLOUT=400
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=100
export PRESET_SAVE_RETAIN_INTERVAL=100

export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32

export PRESET_ATTN_IMPL=tilelang

export PRESET_LR=1e-5
export PRESET_LR_DECAY_STYLE=cosine
export PRESET_LR_WARMUP_ITERS=20

export V4_SFT_DATA=$V4_DATA/albaliang_057_le64k.jsonl
export PRESET_TOOL_KEY=tools

export HW_MAX_TOKENS_PER_GPU=32768

export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1

# wandb
export PRESET_USE_WANDB=1
export PRESET_WANDB_PROJECT=v4-flash-post
export PRESET_WANDB_TEAM=kaynzhang-none
# Set PRESET_WANDB_API_KEY in the shell or secret manager before launch.
export PRESET_WANDB_API_KEY=${PRESET_WANDB_API_KEY:-}

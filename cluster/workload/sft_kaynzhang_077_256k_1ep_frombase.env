#!/usr/bin/env bash
# Workload: kaynzhang_077 256K V4 agent SFT, 1 epoch, FRESH from the ORIGINAL V4-Flash base.
#
# Differs from sft_kaynzhang_077_256k_2epoch (which CONTINUED from the 134K SFT ckpt):
#   - PRESET_REF_LOAD_DIR = $V4_TORCH_DIST  → initial weights = the ORIGINAL DeepSeek-V4-Flash
#     base (底座重训), NOT any prior SFT checkpoint. Fresh optimizer + fresh cosine LR from iter 0.
#   - 1 epoch (was 2). ~156 steps (job2 20000-sample set / global-batch 128, pre-convert).
#   - max-tokens-per-gpu 50000→52480: token_cap = 52480×5(CP) = 262400 = seq-length, so the
#     longest real sample (~262138) fits as a clean singleton microbatch + better packing.
#     ⚠ PP4CP5DP2 already runs ~89% memory; if step 1-3 OOM, fall back to 50000.
#   - Runs on the 40-node fleet (CP5). 2 nodes removed from the Ray pool at the DaemonSet
#     level: 10.3.110.134 (SageMaker TaskHung/SoftwareError) and 10.3.74.204.
# Data: the albaliang 077 job2 256K-curation 2w sample (train_sample_2w.jsonl), converted
# from raw {tool_call-role, per-message loss} schema to V4 via tools/convert_raw_to_v4_sft.py.

export PRESET_NAME=sft_kaynzhang_077_256k_1ep_frombase
export PRESET_RUN_ID_PREFIX=stageKaynzhang077-256K-1ep-frombase-H200
export PRESET_NUM_EPOCH=1
export PRESET_DEBUG_TRAIN_ONLY=0
export PRESET_DUMP_DETAILS=0
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=100
export PRESET_SAVE_RETAIN_INTERVAL=500
export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32
export PRESET_ATTN_IMPL=tilelang
export PRESET_CPU_OFFLOAD_FLAGS=""
export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=cosine
export PRESET_LR_WARMUP_ITERS=20
export PRESET_USE_WANDB=1
export PRESET_WANDB_PROJECT=v4-flash-post
export PRESET_WANDB_TEAM=kaynzhang-none
export PRESET_WANDB_API_KEY_FILE=${PRESET_WANDB_API_KEY_FILE:-$V4_WORK/.secrets/wandb_api_key}
export V4_SFT_DATA=$V4_DATA/albaliang_077_job2_2w_v4_le256k.jsonl
export PRESET_TOOL_KEY=tools

# CP5: seq_length must be divisible by 2*CP=10. 262400/10=26240 ✓ (same value the prior 256K
# run used → tilelang @jit kernel cache is warm, no ~40min first-step recompile).
export HW_SEQ_LENGTH=262400
export HW_MAX_TOKENS_PER_GPU=52480
export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1

# Initial weights = the ORIGINAL V4-Flash base (底座重训). New RUN_ID → --load (SAVE_DIR/
# checkpoints) is empty → init falls back to --ref-load (weights only, fresh optimizer + LR).
export PRESET_REF_LOAD_DIR=$V4_TORCH_DIST

# --- carried over from the 134K/256K runs (validated wins) ---
export PRESET_MANUAL_GC=1
export PRESET_MANUAL_GC_INTERVAL=10
export PRESET_MOE_FUSION=1   # permute-fusion only (router-fusion incompatible w/ sqrtsoftplus)
export PRESET_ASYNC_ROLLOUT_PREFETCH=1

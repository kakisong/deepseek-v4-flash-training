#!/usr/bin/env bash
# H20-mirror MFU probe: reproduce the H20 stageAlb128K-3ep config (40% MFU) on H200,
# at H20's scale (16 nodes, TP8 PP4 CP4 EP8) with H20's algorithm settings, to test
# whether the H200 11% MFU is strong-scaling/CP overhead rather than a structural wall.
#
# Launch:
#   V4_CONTROL=current V4_FLEET=h200_k8s_16node V4_SCALE=tp8pp4cp4ep8 \
#     V4_WORKLOAD=sft_h20mirror_pp4cp4_probe bash run.sh
#
# Deltas vs sft_kaynzhang_077_134k_3epoch (the 11% baseline):
#   scale     : tp8pp4cp4ep8 (16 nodes) instead of tp8pp7cp6ep8 (42 nodes)
#   offload   : optimizer-cpu-offload ON (H20 had it; 3epoch disabled it -> caused my false OOM)
#   recompute : full/uniform/1 (H20) instead of full/block/4
# Everything else (data, seq, max_tokens, gb, banked kernel/flag wins) held identical.
export PRESET_NAME=sft_h20mirror_pp4cp4_probe
export PRESET_RUN_ID_PREFIX=stageH20mirror-PP4CP4-H200
export PRESET_NUM_ROLLOUT=20            # short MFU probe; must exceed warmup iters (megatron asserts warmup<decay)
export PRESET_DEBUG_TRAIN_ONLY=1
export PRESET_GLOBAL_BATCH_SIZE=128
export PRESET_ROLLOUT_BATCH_SIZE=128
export PRESET_SAVE_INTERVAL=1000        # no checkpointing during the probe
export PRESET_SAVE_RETAIN_INTERVAL=1000
# deep_ep NOT installed in sft-only image -> use alltoall dispatcher (what the 11% baseline
# actually ran; the old --moe-enable-deepep flag was a silent no-op fallback to alltoall).
export PRESET_MOE_DEEPEP=1
export PRESET_MOE_ROUTER_DTYPE=fp32
export PRESET_ATTN_IMPL=tilelang
export PRESET_LR=5e-6
export PRESET_LR_DECAY_STYLE=cosine
export PRESET_LR_WARMUP_ITERS=2         # probe is only 20 steps; keep warmup < total (H20's 20 was for a multi-k-step run)
export PRESET_USE_WANDB=1
export PRESET_WANDB_PROJECT=v4-flash-post
export PRESET_WANDB_TEAM=kaynzhang-none
export PRESET_WANDB_API_KEY_FILE=${PRESET_WANDB_API_KEY_FILE:-$V4_WORK/.secrets/wandb_api_key}
export V4_SFT_DATA=$V4_DATA/albaliang_077_le128k.jsonl
export PRESET_TOOL_KEY=tools
export HW_SEQ_LENGTH=131208
export HW_MAX_TOKENS_PER_GPU=32768
# H20's recompute (lighter than 3epoch's block/4); offload frees the memory for uniform/1.
export HW_RECOMPUTE_GRANULARITY=full
export HW_RECOMPUTE_METHOD=uniform
export HW_RECOMPUTE_NUM_LAYERS=1
# Optimizer CPU offload ON -- the key memory lever H20 used and the 3epoch baseline dropped.
export PRESET_CPU_OFFLOAD_FLAGS="--optimizer-cpu-offload --overlap-cpu-optimizer-d2h-h2d --use-precision-aware-optimizer"
# Banked validated wins (EFA 3x already in image; these are the +5%).
export PRESET_MANUAL_GC=1
export PRESET_MANUAL_GC_INTERVAL=10
export PRESET_MOE_FUSION=1
export PRESET_REF_LOAD_DIR=$V4_TORCH_DIST

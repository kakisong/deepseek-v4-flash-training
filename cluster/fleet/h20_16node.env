#!/usr/bin/env bash
# Fleet: 主用 16 节点 H20 作业节点池 (10.0.8.2-17)。
#
# 这个文件描述"本次 job 希望使用哪批物理机 + 镜像/mount/容量"。
# 固定 Ray head/job submit/dashboard 入口放在 control/current.env。
# 不含并行参数(scale/)、不含训练 workload(workload/)、不含路径派生(base.env)。

# Topology
export V4_NUM_NODES=16
export V4_NUM_GPUS_PER_NODE=8
export V4_MASTER_IP=10.0.8.17  # legacy first node; submit endpoint uses V4_RAY_HEAD_IP from control/.
export V4_WORKER_IPS="10.0.8.10 10.0.8.11 10.0.8.12 10.0.8.13 10.0.8.14 10.0.8.15 10.0.8.16 10.0.8.2 10.0.8.3 10.0.8.4 10.0.8.5 10.0.8.6 10.0.8.7 10.0.8.8 10.0.8.9"
export V4_ALL_IPS="$V4_MASTER_IP $V4_WORKER_IPS"

# Cluster identity (用于选 hw/$V4_GPU_MODEL.env;V4_CLUSTER_NAME 也是 GCS Redis namespace)
export V4_CLUSTER_NAME=h20_16node
export V4_GPU_MODEL=h20

# Project artifact root on shared CFS
export V4_WORK=/data_train/kaynzhang/v4-sft

# Container image + name
export V4_IMAGE=${V4_IMAGE:-radixark/miles:dev-fht-v4deps-20260529}
export V4_CONTAINER=miles-v4-sft

# Ray + dashboard ports (legacy fallback when V4_CONTROL is not set).
export V4_RAY_PORT=6379
export V4_DASHBOARD_PORT=8201

# GCS external Redis (legacy fallback when V4_CONTROL is not set).
# Keep disabled for this fleet: reusing the shared Redis preserved stale Ray
# node records across cluster recreations, which polluted the dashboard/state API.
export V4_REDIS_HOST=
export V4_REDIS_PORT=6379
export V4_REDIS_PASSWORD=

# Monitoring (legacy fallback when V4_CONTROL is not set).
export V4_PROMETHEUS_PORT=40001
export V4_GRAFANA_PORT=7777
export V4_CADDY_PORT=8200
export V4_PUBLIC_URL=https://kaynzhang.woa.com
export V4_GRAFANA_HOST=http://10.0.8.17:${V4_GRAFANA_PORT}
export V4_PROMETHEUS_HOST=http://10.0.8.17:${V4_PROMETHEUS_PORT}/promql
export V4_GRAFANA_IFRAME_HOST=${V4_PUBLIC_URL}/grafana

# Outbound proxy
export V4_HTTP_PROXY=http://172.26.0.3:8081

# Timezone (ray dashboard / log timestamps)
export V4_TZ=Asia/Shanghai

# Docker bind mounts
export V4_DOCKER_MOUNTS=(
  "/data_train:/data_train"
  "/data0:/ray_local"
  "/dev/infiniband:/dev/infiniband"
)

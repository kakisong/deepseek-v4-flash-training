#!/usr/bin/env bash
# Fleet:12 台空闲 H20 节点,在 10.0.8.2-5 被占用时避开这些主机。
# 作业首节点固定在 10.0.8.17;worker 为 10.0.8.6-16。
# 固定的 Ray head/作业提交/dashboard 入口在 control/current.env 中。

export V4_NUM_NODES=12
export V4_NUM_GPUS_PER_NODE=8
export V4_MASTER_IP=10.0.8.17  # 旧版的首节点;提交端点使用 control/ 中的 V4_RAY_HEAD_IP。
export V4_WORKER_IPS="10.0.8.6 10.0.8.7 10.0.8.8 10.0.8.9 10.0.8.10 10.0.8.11 10.0.8.12 10.0.8.13 10.0.8.14 10.0.8.15 10.0.8.16"
export V4_ALL_IPS="$V4_MASTER_IP $V4_WORKER_IPS"

export V4_CLUSTER_NAME=h20_12node_6_17
export V4_GPU_MODEL=h20

export V4_WORK=/data_train/kaynzhang/v4-sft

export V4_IMAGE=radixark/miles:dev-fht-v4deps-20260529
export V4_CONTAINER=miles-v4-sft

# 使用与 16 节点默认值不同的 Ray 端口,使 10.0.8.2-5 上残留的 worker
# 无法重新加入这个 12 节点验证集群。
export V4_RAY_PORT=6389
export V4_DASHBOARD_PORT=8212

# 让这个探测集群保持临时性。复用外部 Redis namespace 会在快速反复
# 拉起重试之间残留过期的 Ray 节点记录。
export V4_REDIS_HOST=
export V4_REDIS_PORT=6379
export V4_REDIS_PASSWORD='devops@CS666'

export V4_PROMETHEUS_PORT=40001
export V4_GRAFANA_PORT=7777
export V4_GRAFANA_HOST=http://10.0.8.17:${V4_GRAFANA_PORT}
export V4_PROMETHEUS_HOST=http://10.0.8.17:${V4_PROMETHEUS_PORT}/promql
export V4_GRAFANA_IFRAME_HOST=https://kaynzhang.woa.com/grafana

export V4_HTTP_PROXY=http://172.26.0.3:8081
export V4_TZ=Asia/Shanghai

export V4_DOCKER_MOUNTS=(
  "/data_train:/data_train"
  "/data0:/ray_local"
  "/dev/infiniband:/dev/infiniband"
)

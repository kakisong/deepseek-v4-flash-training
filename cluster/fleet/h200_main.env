#!/usr/bin/env bash
# Fleet:主 42 节点 H200 worker 池。
#
# 本文件描述一次作业所用的物理机器、image、mount 与容量。
# 固定的 Ray head/作业提交/dashboard 入口在 control/h200_main.env 中。
#
# Ray 拓扑:
#   - 1 个仅 CPU 的 head:10.3.234.60
#   - 42 台 H200 worker:共 336 张 GPU

# 拓扑
export V4_NUM_NODES=42
export V4_NUM_GPUS_PER_NODE=8
export V4_MASTER_IP=10.3.234.60  # gpu-node-64 / hyperpod-i-0d4e32b7b3a91c397;提交端点使用 control/ 中的 V4_RAY_HEAD_IP。
export V4_WORKER_IPS="10.3.231.57 10.3.177.151 10.3.90.17 10.3.100.223 10.3.75.76 10.3.200.212 10.3.77.237 10.3.129.14 10.3.149.150 10.3.42.250 10.3.94.204 10.3.114.26 10.3.156.154 10.3.110.134 10.3.210.84 10.3.187.119 10.3.51.195 10.3.109.113 10.3.160.69 10.3.215.210 10.3.119.193 10.3.213.194 10.3.99.147 10.3.80.162 10.3.161.149 10.3.95.222 10.3.125.77 10.3.113.170 10.3.214.113 10.3.230.176 10.3.140.30 10.3.83.9 10.3.28.82 10.3.152.29 10.3.221.217 10.3.145.184 10.3.170.218 10.3.212.180 10.3.15.169 10.3.22.244 10.3.74.204 10.3.217.156"
export V4_ALL_IPS="$V4_MASTER_IP $V4_WORKER_IPS"

# 仅 CPU 的 head 与全部 GPU worker 加入后,Ray 应有的容量。
export V4_RAY_HEAD_NUM_GPUS=0
export V4_EXPECTED_RAY_NODES=43
export V4_EXPECTED_GPUS=336

# 集群标识(用于选择 hw/$V4_GPU_MODEL.env;也用作 Ray namespace)。
export V4_CLUSTER_NAME=h200_main
export V4_GPU_MODEL=h200

# 共享存储上的项目产物根目录。
export V4_WORK=/data_train/kaynzhang/v4-sft

# 容器 image + 名称。
export V4_IMAGE=${V4_IMAGE:-e1/deepseek-v4-flash:sft-only-20260609}
export V4_CONTAINER=miles-v4-sft

# Ray + dashboard 端口(未设置 V4_CONTROL 时的旧版回退)。
export V4_RAY_PORT=6379
export V4_DASHBOARD_PORT=8201

# 保持外部 Redis 处于禁用状态;过期的 GCS 状态可能在集群重建后
# 污染 Ray 状态。
export V4_REDIS_HOST=
export V4_REDIS_PORT=6379
export V4_REDIS_PASSWORD=

# 监控(未设置 V4_CONTROL 时的旧版回退)。
export V4_PROMETHEUS_PORT=40001
export V4_GRAFANA_PORT=7777
export V4_CADDY_PORT=8200
export V4_PUBLIC_URL=${V4_PUBLIC_URL:-http://${V4_MASTER_IP}:${V4_CADDY_PORT}}
export V4_GRAFANA_HOST=http://${V4_MASTER_IP}:${V4_GRAFANA_PORT}
export V4_PROMETHEUS_HOST=http://${V4_MASTER_IP}:${V4_PROMETHEUS_PORT}/promql
export V4_GRAFANA_IFRAME_HOST=${V4_PUBLIC_URL}/grafana

# 出站代理。
export V4_HTTP_PROXY=${V4_HTTP_PROXY:-http://172.26.0.3:8081}

# 时区(Ray dashboard / 日志时间戳)。
export V4_TZ=Asia/Shanghai

# Docker bind mount。
export V4_DOCKER_MOUNTS=(
  "/data_train:/data_train"
  "/data0:/ray_local"
  "/dev/infiniband:/dev/infiniband"
)

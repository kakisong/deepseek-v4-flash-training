#!/usr/bin/env bash
# Fleet:当前的 K8s Ray head 加 42 台 H200 训练 worker。
#
# 与 2026-06-04 的 gpu-node-64 控制面相匹配:
#   - 仅 CPU 的 Ray head:10.3.234.60
#   - 42 台 H200 worker:共 336 张 GPU
#
# 路径为当前 K8s Ray pods 内部可见的挂载点,而非旧的
# /data_train/kaynzhang/v4-sft Docker 布局。

export V4_NUM_NODES=42
export V4_NUM_GPUS_PER_NODE=8
export V4_MASTER_IP=10.3.234.60
export V4_WORKER_IPS="10.3.231.57 10.3.177.151 10.3.90.17 10.3.100.223 10.3.75.76 10.3.200.212 10.3.77.237 10.3.129.14 10.3.149.150 10.3.42.250 10.3.94.204 10.3.114.26 10.3.156.154 10.3.110.134 10.3.210.84 10.3.187.119 10.3.51.195 10.3.109.113 10.3.160.69 10.3.215.210 10.3.119.193 10.3.213.194 10.3.99.147 10.3.80.162 10.3.161.149 10.3.95.222 10.3.125.77 10.3.113.170 10.3.214.113 10.3.230.176 10.3.140.30 10.3.83.9 10.3.28.82 10.3.152.29 10.3.221.217 10.3.145.184 10.3.170.218 10.3.212.180 10.3.15.169 10.3.22.244 10.3.74.204 10.3.217.156"
export V4_ALL_IPS="$V4_MASTER_IP $V4_WORKER_IPS"

export V4_RAY_HEAD_NUM_GPUS=0
export V4_EXPECTED_RAY_NODES=43
export V4_EXPECTED_GPUS=336

export V4_CLUSTER_NAME=h200_k8s_42node
export V4_GPU_MODEL=h200

export V4_WORK=/mnt/fsx-cdsn/kaynzhang/deepseek-v4-flash
export V4_MILES_REPO=$V4_WORK/train/miles
export V4_TRAINING_REPO=$V4_WORK/train/deepseek-v4-flash-training

export V4_IMAGE=${V4_IMAGE:-e1/deepseek-v4-flash:sft-only-20260609}
export V4_CONTAINER=miles-v4-sft
export V4_SUBMIT_MODE=k8s
export V4_K8S_NAMESPACE=ray-system
export V4_K8S_HEAD_DEPLOY=ray-head-gpu-node-64
export V4_K8S_HEAD_CONTAINER=ray-head

export V4_RAY_PORT=6379
export V4_DASHBOARD_PORT=8201
export V4_RAY_ENTRYPOINT_RESOURCES=${V4_RAY_ENTRYPOINT_RESOURCES:-'{"node:10.3.231.57":0.001}'}
export V4_ROLLOUT_MANAGER_RESOURCES=${V4_ROLLOUT_MANAGER_RESOURCES:-$V4_RAY_ENTRYPOINT_RESOURCES}
export V4_RAY_DRIVER_CUDA_VISIBLE_DEVICES=${V4_RAY_DRIVER_CUDA_VISIBLE_DEVICES:-0}
export V4_RAY_DRIVER_NOSET_CUDA_VISIBLE_DEVICES=${V4_RAY_DRIVER_NOSET_CUDA_VISIBLE_DEVICES:-1}
export V4_PROMETHEUS_PORT=40001
export V4_GRAFANA_PORT=7777
export V4_CADDY_PORT=8200
export V4_PUBLIC_URL=${V4_PUBLIC_URL:-http://${V4_MASTER_IP}:${V4_CADDY_PORT}}
export V4_GRAFANA_HOST=http://${V4_MASTER_IP}:${V4_GRAFANA_PORT}
export V4_PROMETHEUS_HOST=http://${V4_MASTER_IP}:${V4_PROMETHEUS_PORT}/promql
export V4_GRAFANA_IFRAME_HOST=${V4_PUBLIC_URL}/grafana

export V4_HTTP_PROXY=${V4_HTTP_PROXY:-http://172.26.0.3:8081}
export V4_TZ=Asia/Shanghai

# 启用 EFA / aws-ofi-nccl。
# 原版 miles 镜像(e1/deepseek-v4-flash:sft-only-20260609)未带 aws-ofi-nccl
# 插件,导致 NCCL 静默回退到走 ENA 的 TCP socket(all-reduce busBW 约 5 GB/s),
# 而 16 块 EFA 网卡(约 400 GB/s)闲置 -> GPU 利用率 100% 但功耗仅约 120W,MFU 约 1-2%。
# 我们把 libfabric(EFA) + aws-ofi-nccl 1.19 + 配套 rdma-core 预置到共享 fsx 上,
# 并让 NCCL 指向它。之后实测 2 节点 busBW:all_reduce 410 GB/s,all_to_all 83 GB/s。
# 设 V4_EFA_ENABLE=0 可关闭,以复现旧的 socket 路径。
export V4_EFA_ENABLE=${V4_EFA_ENABLE:-1}
export V4_EFA_ROOT=${V4_EFA_ROOT:-/mnt/fsx-cdsn/kaynzhang/deepseek-v4-flash/efa/root}

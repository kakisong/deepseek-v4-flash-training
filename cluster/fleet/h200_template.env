#!/usr/bin/env bash
# H200 cluster config template — copy to cluster_h200_<your-name>.env and fill in real values.
# Usage: V4_CLUSTER=h200_<your-name> bash run.sh <preset>

# Cluster identity (used to select hw/$V4_GPU_MODEL.env).
export V4_CLUSTER_NAME=h200_TEMPLATE
export V4_GPU_MODEL=h200

# Topology — fill in actual values.
export V4_NUM_NODES=16                       # e.g. 16 nodes x 8 GPU = 128 H200
export V4_NUM_GPUS_PER_NODE=8
export V4_MASTER_IP=10.x.x.x                 # node hosting the ray head
export V4_WORKER_IPS="10.x.x.x 10.x.x.x ..." # space-separated, N-1 worker IPs
export V4_ALL_IPS="$V4_MASTER_IP $V4_WORKER_IPS"

# V4-Flash artifact root — must be the same path on every node.
# Prefer CFS / Lustre / other shared storage. For local NVMe, rsync the tree to every node.
export V4_WORK=/your/shared/storage/v4-sft

# Container — see BOOTSTRAP.md for how to sync the image across nodes.
export V4_IMAGE=radixark/miles:dev           # or another V4-compatible image
export V4_CONTAINER=miles-v4-sft

# Ray + monitoring ports — pick according to the cluster's firewall policy.
export V4_RAY_PORT=6379
export V4_DASHBOARD_PORT=8201
export V4_PROMETHEUS_PORT=40001
export V4_GRAFANA_PORT=7777

# External Redis for GCS — provides head-restart fault tolerance; leave empty to skip external Redis.
# (lock_timeout is NOT a Ray flag; it's consumed by downstream redis-lock clients.)
export V4_REDIS_HOST=               # e.g. 10.0.0.55
export V4_REDIS_PORT=6379
export V4_REDIS_PASSWORD=           # e.g. 'devops@CS666'
export V4_REDIS_LOCK_TIMEOUT=6000

# Container + Ray timezone — affects Ray dashboard and log timestamps.
export V4_TZ=Asia/Shanghai
export V4_GRAFANA_HOST=http://${V4_MASTER_IP}:${V4_GRAFANA_PORT}
export V4_PROMETHEUS_HOST=http://${V4_MASTER_IP}:${V4_PROMETHEUS_PORT}

# Outbound proxy — unset when no proxy is needed.
# export V4_HTTP_PROXY=http://your-proxy:port
unset V4_HTTP_PROXY

# Docker bind mounts — must at least include the storage backing V4_WORK and the InfiniBand devices.
export V4_DOCKER_MOUNTS=(
  "/your/shared/storage:/your/shared/storage"   # same root as V4_WORK
  "/dev/infiniband:/dev/infiniband"
)

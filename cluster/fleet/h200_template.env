#!/usr/bin/env bash
# H200 作业节点池模板——复制为 h200_<your-name>.env 并填入真实值。
# 固定的 Ray head/作业提交/dashboard 入口放在 cluster/control/<name>.env 中。

# 集群标识(用于选择 hw/$V4_GPU_MODEL.env)。
export V4_CLUSTER_NAME=h200_TEMPLATE
export V4_GPU_MODEL=h200

# 拓扑——填入实际值。
export V4_NUM_NODES=16                       # 例如 16 节点 x 8 GPU = 128 张 H200
export V4_NUM_GPUS_PER_NODE=8
export V4_MASTER_IP=10.x.x.x                 # 旧版的首节点;提交端点应使用 V4_RAY_HEAD_IP。
export V4_WORKER_IPS="10.x.x.x 10.x.x.x ..." # 空格分隔,共 N-1 个 worker IP
export V4_ALL_IPS="$V4_MASTER_IP $V4_WORKER_IPS"

# V4-Flash 产物根目录——在每个节点上必须是同一路径。
# 优先使用 CFS / Lustre / 其他共享存储。若用本地 NVMe,需把目录树 rsync 到每个节点。
export V4_WORK=/your/shared/storage/v4-sft

# 容器——各节点间同步 image 的方法见 BOOTSTRAP.md。
export V4_IMAGE=radixark/miles:dev           # 或其他兼容 V4 的 image
export V4_CONTAINER=miles-v4-sft

# 未设置 V4_CONTROL 时的旧版控制面回退。建议改在
# cluster/control/<name>.env 中定义,并以 --control <name> 运行。
export V4_RAY_PORT=6379
export V4_DASHBOARD_PORT=8201
export V4_PROMETHEUS_PORT=40001
export V4_GRAFANA_PORT=7777

# 未设置 V4_CONTROL 时的旧版外部 Redis 回退。
# (lock_timeout 不是 Ray 参数;它由下游的 redis-lock 客户端消费。)
export V4_REDIS_HOST=               # 例如 10.0.0.55
export V4_REDIS_PORT=6379
export V4_REDIS_PASSWORD=           # 例如 'devops@CS666'
export V4_REDIS_LOCK_TIMEOUT=6000

# 未设置 V4_CONTROL 时的旧版监控回退。
export V4_TZ=Asia/Shanghai
export V4_GRAFANA_HOST=http://${V4_MASTER_IP}:${V4_GRAFANA_PORT}
export V4_PROMETHEUS_HOST=http://${V4_MASTER_IP}:${V4_PROMETHEUS_PORT}

# 出站代理——不需要代理时保持 unset。
# export V4_HTTP_PROXY=http://your-proxy:port
unset V4_HTTP_PROXY

# Docker bind mount——至少须包含承载 V4_WORK 的存储和 InfiniBand 设备。
export V4_DOCKER_MOUNTS=(
  "/your/shared/storage:/your/shared/storage"   # 与 V4_WORK 同根
  "/local/nvme/ray:/ray_local"                  # 宿主机本地盘,放 Ray 日志/溢写/临时文件
  "/dev/infiniband:/dev/infiniband"
)

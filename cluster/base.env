#!/usr/bin/env bash
# V4-Flash 的项目级路径约定,与任何具体集群无关。
# fleet/*.env 提供 V4_WORK;本文件据此派生其余全部路径。
#
# 用法:经由 ../env.sh shim 间接 source。**不要直接 source**
# (否则 V4_WORK 未设置,source 会失败)。

: "${V4_WORK:?V4_WORK must be set by fleet/*.env before sourcing base.env}"

# 源码仓库路径。
#
# V4_MILES_REPO  — radixark/miles fork(kakisong/miles)的 clone。提供 train.py
#                  + miles 框架 + V4 模型插件(miles_plugins/models/deepseek_v4)。
# V4_TRAINING_REPO — 本仓库(kakisong/deepseek-v4-flash-training)。提供
#                  集群拉起脚本 + 数据/ckpt 准备工具。
#
# 两者默认均为 V4_WORK/<name>;开发者可在 source 本文件之前用环境变量
# 覆盖其中任一(例如把 V4_MILES_REPO 指向本地可编辑的 checkout)。
export V4_MILES_REPO=${V4_MILES_REPO:-$V4_WORK/miles}
export V4_TRAINING_REPO=${V4_TRAINING_REPO:-$V4_WORK/deepseek-v4-flash-training}
# 向后兼容别名,供仍在使用 $V4_MILES 的 shell 脚本。
export V4_MILES=$V4_MILES_REPO

# 宿主机侧 Megatron 路径,供转换/调试工具使用。训练运行时应使用
# 下面烧录进镜像的路径,而非这个 CFS checkout。
export V4_MEGATRON=${V4_MEGATRON:-$V4_WORK/Megatron-LM}

# 容器侧框架代码,已烧录进训练镜像。
export V4_CONTAINER_MEGATRON=${V4_CONTAINER_MEGATRON:-/root/Megatron-LM}
export V4_CONTAINER_TILE_KERNELS=${V4_CONTAINER_TILE_KERNELS:-/root/TileKernels}
export V4_RUNTIME_PYTHONPATH=${V4_RUNTIME_PYTHONPATH:-$V4_CONTAINER_MEGATRON:$V4_CONTAINER_TILE_KERNELS}

# 数据 / 模型。
export V4_MODELS=$V4_WORK/models
export V4_DATA=$V4_WORK/data
export V4_OUT=$V4_WORK/outputs
export V4_HF_DIR=$V4_MODELS/DeepSeek-V4-Flash-FP8        # 软链接 → DeepSeek-V4-Flash
# 指向我们自行转换出来的、真正解包后的 BF16 HF 目录。
# (DeepSeek-V4-Flash-FP8-bf16 是社区打包的 FP4/FP8 目录,缺少 scales,不可用。)
# 由 tools/megablocks_to_hf_bf16.py 从 SRC megablocks 目录生成。
export V4_BF16_DIR=$V4_MODELS/DeepSeek-V4-Flash-bf16-unpacked
# 基础模型的 torch_dist(mbridge)checkpoint = 全新 SFT 的默认 --ref-load
# (preflight.sh:106 还硬性要求任何运行都必须存在该目录,因此它必须有效)。
# 2026-06-09:已从现已删除的 DeepSeek-V4-Flash-bf16_torch_dist 重新指向当前
# 531G / 128 分片的 "release" checkpoint DeepSeek-V4-Flash-FP8_torch_dist(由完好的
# megablocks 源 DeepSeek-V4-Flash 转换而来;"FP8" 只是配方标签——磁盘上的权重是 BF16)。
export V4_TORCH_DIST=$V4_MODELS/DeepSeek-V4-Flash-FP8_torch_dist
export V4_SFT_DATA=$V4_DATA/openhermes_v4.parquet

# HF 缓存(覆盖系统级 profile.d 里那些不可写的目录)。
export V4_HF_HOME=$V4_WORK/.cache/huggingface
mkdir -p "$V4_HF_HOME"

mkdir -p "$V4_OUT"

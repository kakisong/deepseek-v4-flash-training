#!/usr/bin/env bash
# Project-level path conventions for V4-Flash, independent of any specific cluster.
# fleet/*.env provides V4_WORK; this file derives everything else from it.
#
# Usage: sourced indirectly via the ../env.sh shim. **Do not source directly**
# (V4_WORK will be unset and sourcing will fail).

: "${V4_WORK:?V4_WORK must be set by fleet/*.env before sourcing base.env}"

# Source repo paths.
#
# V4_MILES_REPO  — radixark/miles fork (kakisong/miles) clone. Provides train.py
#                  + miles framework + V4 model plugin (miles_plugins/models/deepseek_v4).
# V4_TRAINING_REPO — this repo (kakisong/deepseek-v4-flash-training). Provides
#                  cluster bring-up scripts + data/ckpt prep tools.
#
# Both default to V4_WORK/<name>; a developer can override either with an env var
# before sourcing this file (e.g. point V4_MILES_REPO at a local editable checkout).
export V4_MILES_REPO=${V4_MILES_REPO:-$V4_WORK/miles}
export V4_TRAINING_REPO=${V4_TRAINING_REPO:-$V4_WORK/deepseek-v4-flash-training}
# Backward-compat alias for shell scripts still using $V4_MILES.
export V4_MILES=$V4_MILES_REPO

# Megatron-LM uses the radixark/Megatron-LM dsv4-pr28 branch on CFS.
# The in-container /root/Megatron-LM is miles-main HEAD and lacks sqrtsoftplus PR #28.
# CFS dsv4-pr28 = miles-main + PR #28 (sqrtsoftplus + partial V4 args).
export V4_MEGATRON=$V4_WORK/Megatron-LM
# deepseek-ai/TileKernels source directory (referenced via PYTHONPATH by hyper_connection.py
# rather than installed inside the container — pip install would pull a fresh torch wheel
# and break transformer_engine ABI compatibility).
export V4_TILE_KERNELS=$V4_WORK/TileKernels

# Data / models.
export V4_MODELS=$V4_WORK/models
export V4_DATA=$V4_WORK/data
export V4_OUT=$V4_WORK/outputs
export V4_HF_DIR=$V4_MODELS/DeepSeek-V4-Flash-FP8        # symlink → DeepSeek-V4-Flash
# Points to the real unpacked BF16 HF dir we cast ourselves.
# (DeepSeek-V4-Flash-FP8-bf16 is the community-packed FP4/FP8 dir, missing scales and unusable.)
# Produced by tools/megablocks_to_hf_bf16.py from the SRC megablocks dir.
export V4_BF16_DIR=$V4_MODELS/DeepSeek-V4-Flash-bf16-unpacked
export V4_TORCH_DIST=$V4_MODELS/DeepSeek-V4-Flash-FP8_torch_dist
export V4_SFT_DATA=$V4_DATA/openhermes_v4.parquet

# HF cache (overrides the system-level profile.d directories that are not writable).
export V4_HF_HOME=$V4_WORK/.cache/huggingface
mkdir -p "$V4_HF_HOME"

mkdir -p "$V4_OUT"
